; 新增非露骨事件口上只显示文字，不改写目标、人物状态或进度。
@CHARACTER_EVENT(CE_P, CE_KIND)
#DIM DYNAMIC CE_P
#DIM DYNAMIC CE_KIND
#DIM DYNAMIC CE_PROFILE
#DIM DYNAMIC CE_VARIANT
#DIMS DYNAMIC CE_TEXT
SIF FLAG:7 <= 0 || CE_P < 0 || CE_P >= CHARANUM || CE_P == MASTER || CE_KIND < 1 || CE_KIND > 12
	RETURN 0
SIF CE_KIND >= CE_JOIN && CE_KIND <= CE_JOB_CLEAR && CASTLE_PERSON:CE_P:CP_ROLE != CR_FOLLOWER && CASTLE_PERSON:CE_P:CP_ROLE != CR_FAMILY
	RETURN 0
SIF CE_KIND == CE_JOIN && (CFLAG:CE_P:451 < 18 || CASTLE_PERSON:CE_P:CP_ROLE != CR_FOLLOWER)
	RETURN 0
SIF (CE_KIND == CE_JOB || CE_KIND == CE_JOB_CLEAR) && CFLAG:CE_P:451 < 18
	RETURN 0
CE_PROFILE = DIALOGUE_PROFILE(CE_P)
SIF CE_PROFILE < 0 || CE_PROFILE >= 1000
	RETURN 0
CE_VARIANT = CHARACTER_LINE_CYCLE:CE_PROFILE:CE_KIND
CE_TEXT '= CHARACTER_EVENT_TEXT(CE_P, CE_KIND, CE_VARIANT)
SIF STRLENS(CE_TEXT) == 0
	RETURN 0
SIF CE_KIND >= CE_JOIN && CE_KIND <= CE_JOB_CLEAR
	PRINTFORM 对这项安排，
PRINTFORML %DIALOGUE_FORMAT(CE_P, CE_TEXT)%
CHARACTER_LINE_CYCLE:CE_PROFILE:CE_KIND = (CE_VARIANT + 1) % 10000
RETURN 1

; 休息只让当前设施一名在场者开口，不隔空调用人物或生成陪伴关系。
@CHARACTER_LOCAL_REST
#DIM DYNAMIC CE_P
SIF FLAG:7 <= 0
	RETURN 0
FOR CE_P, 0, CHARANUM
	SIF CE_P == MASTER || CFLAG:CE_P:1 != 0 || CASTLE_WHERE(CE_P) != CASTLE_STATE:2
		CONTINUE
	CALL CHARACTER_EVENT(CE_P, CE_REST)
	RETURN RESULT
NEXT
RETURN 0

; 每种身份/人格选择一名在城者，避免大量普通NPC把结局刷成重复名册。
@CHARACTER_EPILOGUE(CE_KIND)
#DIM DYNAMIC CE_KIND
#DIM DYNAMIC CE_P
#DIM DYNAMIC CE_PROFILE
#DIM DYNAMIC CE_SHOWN, 1000
#DIM DYNAMIC CE_HEADER
SIF FLAG:7 <= 0 || CE_KIND < CE_WORLD_END || CE_KIND > CE_NORMAL_END
	RETURN 0
FOR CE_P, 0, CHARANUM
	SIF CE_P == MASTER || CFLAG:CE_P:1 != 0
		CONTINUE
	CE_PROFILE = DIALOGUE_PROFILE(CE_P)
	SIF CE_PROFILE < 0 || CE_PROFILE >= 1000 || CE_SHOWN:CE_PROFILE
		CONTINUE
	IF CE_HEADER == 0
		DRAWLINE
		PRINTL 【城中众人】
		CE_HEADER = 1
	ENDIF
	CALL CHARACTER_EVENT(CE_P, CE_KIND)
	CE_SHOWN:CE_PROFILE = 1
NEXT
RETURN CE_HEADER
