; Origin topic continuations.
; 初见只在真正进入在场交谈时发生；菜单重画不重播。
@DIALOGUE_OPEN(DL_P)
#DIM DYNAMIC DL_P
IF DIALOGUE_PERSON:DL_P:DP_MET == 0
	IF CASTLE_PERSON:DL_P:CP_ROLE == CR_FAMILY && DIALOGUE_IS_UNIQUE(DL_P) == 0
		CALL DIALOGUE_PROSE(DL_P, "你走到__NPC_NAME__身边，听对方说起今天想和你谈的事。")
	ELSE
		CALL DIALOGUE_PROSE(DL_P, DIALOGUE_CHARACTER_TEXT(DL_P, 0))
	ENDIF
	DIALOGUE_PERSON:DL_P:DP_MET = 1
	SIF DIALOGUE_PROFILE(DL_P) == 171
		CALL DIALOGUE_MAO_NEWS(DL_P)
ELSE
	CALL DIALOGUE_GREETING(DL_P)
ENDIF
RETURN

; 莉莉初见先问妹妹；只报告当前名册事实，不凭对白编造平安或重逢。
@DIALOGUE_MAO_NEWS(DL_P)
#DIM DYNAMIC DL_P
#DIM DYNAMIC DL_MAO
DL_MAO = FINDCHARA(NO, 17)
IF DL_MAO < 0
	CALL DIALOGUE_PROSE(DL_P, "你把目前能确认的情况说清：城内名册暂时找不到玛奥，尚不能向她保证妹妹现在的处境。她听完，仍坚持以后有确切消息就告诉她。")
ELSEIF CASTLE_WHERE(DL_MAO) > 0 && CFLAG:DL_MAO:1 == 0
	PRINTFORMW 你按城内名册说明：%NAME:DL_MAO%目前在%CASTLE_PLACE_NAME(CASTLE_WHERE(DL_MAO))%。%NAME:DL_P%记下这个地点，仍想亲自确认妹妹的近况。
ELSE
	CALL DIALOGUE_PROSE(DL_P, "你说明名册中有玛奥的记录，但目前还不能确认她在城内的位置。莉莉听得很仔细，不肯把尚未确认的部分当作保证。")
ENDIF
RETURN

@DIALOGUE_GREETING(DL_P)
#DIM DYNAMIC DL_P
IF CASTLE_PERSON:DL_P:CP_ROLE == CR_FAMILY && DIALOGUE_IS_UNIQUE(DL_P) == 0
	CALL DIALOGUE_PROSE(DL_P, "__NPC_NAME__看见你过来，先问你是否有空听听今天的事。")
ELSE
	CALL DIALOGUE_PROSE(DL_P, DIALOGUE_GREETING_TEXT(DL_P))
ENDIF
RETURN

@DIALOGUE_VOICE(DL_P)
#DIM DYNAMIC DL_P
CALL DIALOGUE_PROSE(DL_P, DIALOGUE_VOICE_TEXT(DL_P))
RETURN

@DIALOGUE_ORIGIN_LINE(DL_P)
#DIM DYNAMIC DL_P
SIF DIALOGUE_ATTITUDE(DL_P) > 0 && DIALOGUE_IS_UNIQUE(DL_P) == 0
	CALL DIALOGUE_DAILY_ORIGIN(DL_P)
RETURN

@DIALOGUE_DAILY(DL_P)
#DIM DYNAMIC DL_P
#DIM DYNAMIC DL_PICK
#DIM DYNAMIC DL_GAIN
CALL DIALOGUE_SCENE_HEADER(DL_P, "闲谈")
CALL DIALOGUE_PROSE(DL_P, DIALOGUE_CHARACTER_TEXT(DL_P, 2, DIALOGUE_SEEN:DL_P:10))
; 命名人物不用通用出身故事替换本人经历。
SIF DIALOGUE_IS_UNIQUE(DL_P) == 0 && DIALOGUE_ATTITUDE(DL_P) > 0
	CALL DIALOGUE_DAILY_ORIGIN(DL_P)
CALL DIALOGUE_OPTION(1, "认真回答对方的问题，再说明你的想法。")
CALL DIALOGUE_OPTION(2, "简单回应，把话题暂时放在这里。")
CALL DIALOGUE_OPTION(3, "打断对方，要求立刻按你的意思表态。")
CALL DIALOGUE_OPTION(0, "提前结束")
CALL DIALOGUE_CHOOSE(3)
DL_PICK = RESULT
DIALOGUE_PERSON:DL_P:DP_DAILY_CHOICE = DL_PICK
IF DL_PICK == 0
	PRINTW 你们暂时结束了交谈，本次行动已使用。
	RETURN
ENDIF
IF DL_PICK == 1
	CALL DIALOGUE_PROSE(DL_P, DIALOGUE_CHARACTER_TEXT(DL_P, 3))
	DL_GAIN = DIALOGUE_SEEN:DL_P:10 == 0 ? 4 # 1
	DIALOGUE_PERSON:DL_P:DP_TRUST = MIN(100, DIALOGUE_PERSON:DL_P:DP_TRUST + DL_GAIN)
	DIALOGUE_PERSON:DL_P:DP_AGREE = MIN(100, DIALOGUE_PERSON:DL_P:DP_AGREE + 1)
ELSEIF DL_PICK == 2
	CALL DIALOGUE_PROSE(DL_P, DIALOGUE_CHARACTER_TEXT(DL_P, 4))
ELSE
	CALL DIALOGUE_PROSE(DL_P, DIALOGUE_CHARACTER_TEXT(DL_P, 5))
	DIALOGUE_PERSON:DL_P:DP_TRUST = MAX(0, DIALOGUE_PERSON:DL_P:DP_TRUST - 4)
ENDIF
DIALOGUE_SEEN:DL_P:10 += 1
PRINTW 交谈结束。日常话题不会直接完成归顺交涉。
RETURN

; 家人、年幼者及仅作生活交流的人物不进入归顺路线。
@DIALOGUE_SOCIAL_SESSION(DL_P)
#DIM DYNAMIC DL_P
#DIM DYNAMIC DL_PICK
SIF DIALOGUE_CHAT_ELIGIBLE(DL_P) == 0
	RETURN 0
IF DIALOGUE_PERSON:DL_P:DP_LAST == DAY * 2 + TIME + 1
	PRINTW 你们本时段已经交流过了。
	RETURN 0
ENDIF
CALL CASTLE_SPEND
SIF RESULT == 0
	RETURN 0
DIALOGUE_PERSON:DL_P:DP_LAST = DAY * 2 + TIME + 1
DIALOGUE_PERSON:DL_P:DP_LAST_TOPIC = 10
CASTLE_PERSON:DL_P:CP_LASTTALK = DIALOGUE_PERSON:DL_P:DP_LAST
SIF DIALOGUE_PERSON:DL_P:DP_MET == 0
	CALL DIALOGUE_OPEN(DL_P)
CALL DIALOGUE_SCENE_HEADER(DL_P, "日常交谈")
IF DIALOGUE_PROFILE(DL_P) == 165 || DIALOGUE_PROFILE(DL_P) == 104
	CALL DIALOGUE_PROSE(DL_P, DIALOGUE_CHARACTER_TEXT(DL_P, 2, DIALOGUE_SEEN:DL_P:10))
ELSE
	CALL DIALOGUE_PROSE(DL_P, "__NPC_NAME__说起今天生活里遇到的一件小事，想听听你的看法。")
ENDIF
CALL DIALOGUE_OPTION(1, "听对方说完，问问哪里需要帮助。")
CALL DIALOGUE_OPTION(2, "一起想一想，怎样处理眼前的小事。")
CALL DIALOGUE_OPTION(3, "不听解释，只催对方照你说的去做。")
CALL DIALOGUE_OPTION(0, "暂时结束")
CALL DIALOGUE_CHOOSE(3)
DL_PICK = RESULT
IF DL_PICK == 0
	PRINTW 你们暂时结束了交谈，本次行动已使用。
	RETURN 1
ENDIF
IF DIALOGUE_PROFILE(DL_P) == 165 || DIALOGUE_PROFILE(DL_P) == 104
	CALL DIALOGUE_PROSE(DL_P, DIALOGUE_CHARACTER_TEXT(DL_P, DL_PICK == 3 ? 5 # 3))
ELSEIF DL_PICK == 3
	CALL DIALOGUE_PROSE(DL_P, "__NPC_NAME__没有再把事情讲下去，刚才没有说清的疑问仍然留着。")
ELSE
	CALL DIALOGUE_PROSE(DL_P, "你们把事情说得更清楚了一些，也商量好遇到困难时怎样求助。")
ENDIF
DIALOGUE_PERSON:DL_P:DP_DAILY_CHOICE = DL_PICK
DIALOGUE_SEEN:DL_P:10 += 1
PRINTW 这次日常交谈告一段落。
RETURN 1

@DIALOGUE_DAILY_ORIGIN(DL_P)
#DIM DYNAMIC DL_P
#DIM DYNAMIC DL_VARIANT
DL_VARIANT = (DIALOGUE_PERSON:DL_P:DP_VARIANT + DIALOGUE_SEEN:DL_P:10) % 3
SELECTCASE DIALOGUE_PERSON:DL_P:DP_ORIGIN * 10 + DL_VARIANT
CASE 10
	CALL DIALOGUE_PROSE(DL_P, "__NPC_NAME__谈起整理装备时的习惯：小东西若是不固定位置，真正需要的时候最容易找不到。")
CASE 11
	CALL DIALOGUE_PROSE(DL_P, "__NPC_NAME__听了一会儿远处的脚步，问起城里值守的人如何交接消息。")
CASE 12
	CALL DIALOGUE_PROSE(DL_P, "话题转到训练。__NPC_NAME__认为，反复练习的意义，是让人在紧张时仍知道下一步做什么。")
CASE 20
	CALL DIALOGUE_PROSE(DL_P, "__NPC_NAME__正在整理随身的物件，谈起能把一天的小事安排清楚，也是一种难得的踏实。")
CASE 21
	CALL DIALOGUE_PROSE(DL_P, "你们聊起今天的饭菜。__NPC_NAME__从一道普通食物，说起了自己偏好的味道。")
CASE 22
	CALL DIALOGUE_PROSE(DL_P, "__NPC_NAME__问起城里白天与夜里的作息，希望能够提前知道哪些时候最忙。")
CASE 30
	CALL DIALOGUE_PROSE(DL_P, "__NPC_NAME__拿一件常见的小事举例，问你更习惯先弄懂原因，还是先记住做法。")
CASE 31
	CALL DIALOGUE_PROSE(DL_P, "你们谈起读书与记笔记。__NPC_NAME__觉得，边缘的小小注记有时比整页抄写更有用。")
CASE 32
	CALL DIALOGUE_PROSE(DL_P, "__NPC_NAME__正在比较两种解释，试着找出它们各自成立的条件，愿意听听你的判断。")
CASE 40
	CALL DIALOGUE_PROSE(DL_P, "__NPC_NAME__谈起礼节，认为有些仪式虽然繁琐，至少能让参与的人知道彼此正在认真对待什么。")
CASE 41
	CALL DIALOGUE_PROSE(DL_P, "话题转到如何处理当众的分歧。__NPC_NAME__更在意问题能否被说清，而非单纯争出输赢。")
CASE 42
	CALL DIALOGUE_PROSE(DL_P, "__NPC_NAME__问起城里的接见习惯，希望能够弄清正式请求应该怎样提出。")
CASE 50
	CALL DIALOGUE_PROSE(DL_P, "__NPC_NAME__谈到坚持习惯的意义：有些事情每天都做，才不会在困境里轻易忘掉自己重视什么。")
CASE 51
	CALL DIALOGUE_PROSE(DL_P, "你们聊起帮助与回报。__NPC_NAME__觉得，真正困难的地方常常在于怎样理解别人实际需要的东西。")
CASE 52
	CALL DIALOGUE_PROSE(DL_P, "__NPC_NAME__提出一个问题：看法不同的人，是否仍能认真履行共同承担的职责？")
CASE 60
	CALL DIALOGUE_PROSE(DL_P, "__NPC_NAME__听着城里的消息，谈起一项规矩怎样才能让初来的人也明白，而不只让熟人钻空子。")
CASE 61
	CALL DIALOGUE_PROSE(DL_P, "你们聊起物资。__NPC_NAME__认为，能否按时交付一件小东西，很能说明合作是否可靠。")
CASE 62
	CALL DIALOGUE_PROSE(DL_P, "__NPC_NAME__问起陌生人如何在城里找到需要的地方，提出了一些让指引更清楚的办法。")
ENDSELECT
RETURN
