; 沿用_DRAW_MAINMENU的日期栏、字体、双线/单线与MENU_BUTTON。
; 正式游戏、对话和试玩均调用同一套显示函数。
@CASTLE_SCREEN_HEADER(CS_TITLE, CS_DETAIL = "")
#DIMS DYNAMIC CS_TITLE
#DIMS DYNAMIC CS_DETAIL
REDRAW 0
ALIGNMENT LEFT
RESETCOLOR
FONTREGULAR
SETFONT
DRAWLINEFORM %UNICODE(0x2550)%
ALIGNMENT RIGHT
FONTBOLD
PRINTFORM 第{DAY / 365}年　{MAX(1, DAY:1)}月{MAX(1, DAY:2)}日（第{DAY + 1}日）
IF TIME == 0
	PRINT 上午
ELSE
	PRINT 下午
ENDIF
PRINTFORML 　(所持金：{MONEY} pts.)　
ALIGNMENT LEFT
FONTREGULAR
DRAWLINEFORM %UNICODE(0x2500)%
SETFONT "ARIEL BLACK"
FONTBOLD
PRINTFORML 　%UNICODE(0x258c)%%CS_TITLE%
FONTREGULAR
SETFONT
SIF STRLENS(CS_DETAIL) > 0
	PRINTFORML 　%CS_DETAIL%
DRAWLINEFORM %UNICODE(0x2500)%
REDRAW 1
RETURN

@DIALOGUE_SCENE_HEADER(DL_P, DL_TITLE)
#DIM DYNAMIC DL_P
#DIMS DYNAMIC DL_TITLE
CALL CASTLE_SCREEN_HEADER(@"%NAME:DL_P%", DL_TITLE)
RETURN

@DIALOGUE_OPTION(DL_NUMBER, DL_TEXT)
#DIM DYNAMIC DL_NUMBER
#DIMS DYNAMIC DL_TEXT
CALL MENU_BUTTON(0, @"[{DL_NUMBER}] %DL_TEXT%", DL_NUMBER)
PRINTL
RETURN

; 仅处理作者允许的称呼占位符，不将正文当作ERB格式代码执行。
@DIALOGUE_STORY_OPTION(DL_P, DL_NUMBER, DL_TEXT)
#DIM DYNAMIC DL_P
#DIM DYNAMIC DL_NUMBER
#DIMS DYNAMIC DL_TEXT
IF CASTLE_PERSON:DL_P:CP_ROLE == CR_FOLLOWER
	CALL DIALOGUE_OPTION(DL_NUMBER, @"重述：%DL_TEXT%")
ELSE
	CALL DIALOGUE_OPTION(DL_NUMBER, DL_TEXT)
ENDIF
RETURN

@DIALOGUE_PROSE(DL_P, DL_TEXT)
#DIM DYNAMIC DL_P
#DIMS DYNAMIC DL_TEXT
PRINTFORMW %DIALOGUE_FORMAT(DL_P, DL_TEXT)%
RETURN

@DIALOGUE_FORMAT(DL_P, DL_TEXT)
#FUNCTIONS
#DIM DYNAMIC DL_P
#DIMS DYNAMIC DL_TEXT
DL_TEXT '= REPLACE(DL_TEXT, "__NPC_NAME__", NAME:DL_P)
DL_TEXT '= REPLACE(DL_TEXT, "__MASTER_NAME__", NAME:MASTER)
DL_TEXT '= REPLACE(DL_TEXT, "__SELF_CALL__", DIALOGUE_SELF(DL_P))
DL_TEXT '= REPLACE(DL_TEXT, "__MASTER_ADDRESS__", DIALOGUE_ADDRESS(DL_P))
RETURNF DL_TEXT
