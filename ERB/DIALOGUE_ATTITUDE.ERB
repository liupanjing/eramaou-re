; 性格决定表达方式；身份、归顺意向、信任与经历决定当前态度。
; 0抗拒被俘 1戒备松动 2有条件合作 3正式归顺。
; 态度每次重新计算，关系下降时会退回，不以谈过几次永久解锁亲昵。
@DIALOGUE_ATTITUDE(DL_P)
#FUNCTION
#DIM DYNAMIC DL_P
#DIM DYNAMIC DL_RELATION
SIF DL_P < 0 || DL_P >= CHARANUM || DL_P == MASTER
	RETURNF 0
SIF CASTLE_PERSON:DL_P:CP_ROLE == CR_FOLLOWER || CASTLE_PERSON:DL_P:CP_ROLE == CR_FAMILY
	RETURNF 3
SIF CASTLE_PERSON:DL_P:CP_ROLE != CR_CAPTIVE
	RETURNF 0
DL_RELATION = MIN(DIALOGUE_PERSON:DL_P:DP_TRUST, DIALOGUE_PERSON:DL_P:DP_AGREE)
SIF DIALOGUE_PERSON:DL_P:DP_CHAPTER < 1 || DL_RELATION < 15
	RETURNF 0
SIF DIALOGUE_PERSON:DL_P:DP_CHAPTER < 2 || DL_RELATION < 40
	RETURNF 1
RETURNF 2

@DIALOGUE_ATTITUDE_NAME(DL_P)
#FUNCTIONS
#DIM DYNAMIC DL_P
SELECTCASE DIALOGUE_ATTITUDE(DL_P)
CASE 0
	RETURNF "抗拒被俘"
CASE 1
	RETURNF "仍有戒备"
CASE 2
	RETURNF "有条件合作"
CASE 3
	RETURNF "已经归顺"
ENDSELECT
RETURNF "戒备"

; 亲近程度供需要信赖的内容使用；讥讽、坏笑和逞强属于人格，不受此门槛限制。
@DIALOGUE_WARM(DL_P)
#FUNCTION
#DIM DYNAMIC DL_P
SIF DL_P < 0 || DL_P >= CHARANUM || DL_P == MASTER
	RETURNF 0
RETURNF CASTLE_PERSON:DL_P:CP_ROLE == CR_FOLLOWER && DIALOGUE_PERSON:DL_P:DP_TRUST >= 70 && DIALOGUE_PERSON:DL_P:DP_AGREE >= 70 && MARK:DL_P:3 == 0

@DIALOGUE_ADDRESS(DL_P)
#FUNCTIONS
#DIM DYNAMIC DL_P
SIF DL_P < 0 || DL_P >= CHARANUM
    RETURNF "你"
SIF CASTLE_PERSON:DL_P:CP_ROLE == CR_FAMILY
    RETURNF NAME:MASTER
RETURNF DIALOGUE_CHARACTER_TEXT(DL_P, 6)

@DIALOGUE_HAS_HISTORY(DL_P)
#FUNCTION
#DIM DYNAMIC DL_P
#DIM DYNAMIC DL_I
FOR DL_I, 1, 4
	SIF DIALOGUE_SEEN:DL_P:DL_I > 0
		RETURNF 1
NEXT
RETURNF 0

@DIALOGUE_GREETING_TEXT(DL_P)
#FUNCTIONS
#DIM DYNAMIC DL_P
RETURNF DIALOGUE_CHARACTER_TEXT(DL_P, 1)

@DIALOGUE_VOICE_TEXT(DL_P)
#FUNCTIONS
#DIM DYNAMIC DL_P
RETURNF DIALOGUE_CHARACTER_TEXT(DL_P, 7)

@DIALOGUE_WHITE_DAILY_TEXT(DL_P, DL_VARIANT)
#FUNCTIONS
#DIM DYNAMIC DL_P
#DIM DYNAMIC DL_VARIANT
RETURNF DIALOGUE_CHARACTER_TEXT(DL_P, 2, DL_VARIANT)

@DIALOGUE_DAILY_REPLY(DL_P, DL_PHASE)
#FUNCTIONS
#DIM DYNAMIC DL_P
#DIM DYNAMIC DL_PHASE
RETURNF DIALOGUE_CHARACTER_TEXT(DL_P, 3)
