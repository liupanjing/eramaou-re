; 新旧入口共用的身份与访问规则。CFLAG:1只记录活动，不代表归顺。
@CASTLE_HAS_FAMILY(CP_P)
#FUNCTION
#DIM DYNAMIC CP_P
SIF CP_P < 0 || CP_P >= CHARANUM || MASTER < 0 || MASTER >= CHARANUM || CP_P == MASTER
	RETURNF 0
SIF EX_TALENT:CP_P:2 || CASTLE_PERSON:CP_P:CP_ROLE == CR_FAMILY
	RETURNF 1
RETURNF CASTLE_KIN_KIND(CP_P, MASTER) > 0 || CASTLE_KIN_KIND(MASTER, CP_P) > 0

@CASTLE_KIN_KIND(CP_A, CP_B)
#FUNCTION
#DIM DYNAMIC CP_A
#DIM DYNAMIC CP_B
#DIM DYNAMIC CP_I
SIF CP_A < 0 || CP_A >= CHARANUM || CP_B < 0 || CP_B >= CHARANUM || CP_A == CP_B
	RETURNF 0
; 旧关系表用NID定位列；未知、重复或尚未对齐的列不能推断永久身份。
SIF CFLAG:CP_A:6 <= 0 || CFLAG:CP_B:6 <= 0
	RETURNF 0
SIF C_RELATION:CP_A:CP_A != CFLAG:CP_A:6 || C_RELATION:CP_B:CP_B != CFLAG:CP_B:6
	RETURNF 0
FOR CP_I, 0, CHARANUM
	SIF CP_I != CP_A && CFLAG:CP_I:6 == CFLAG:CP_A:6
		RETURNF 0
	SIF CP_I != CP_B && CFLAG:CP_I:6 == CFLAG:CP_B:6
		RETURNF 0
NEXT
SIF INRANGE(RF_GET(CP_A, CP_B), 1, 8)
	RETURNF RF_GET(CP_A, CP_B)
RETURNF 0

@CASTLE_ROLE(CP_P)
#FUNCTION
#DIM DYNAMIC CP_P
#DIM DYNAMIC CP_SAVED
SIF CP_P < 0 || CP_P >= CHARANUM
	RETURNF 0
SIF CP_P == MASTER
	RETURNF CR_MASTER
SIF CASTLE_HAS_FAMILY(CP_P)
	RETURNF CR_FAMILY
SIF CFLAG:CP_P:1 == 2
	RETURNF CR_HOSTILE
CP_SAVED = CASTLE_PERSON:CP_P:CP_ROLE
SIF CP_SAVED == CR_CAPTIVE || CP_SAVED == CR_FOLLOWER
	RETURNF CP_SAVED
IF CP_SAVED == CR_HOSTILE
	SIF CFLAG:CP_P:1 == 0
		RETURNF CR_CAPTIVE
	RETURNF CR_HOSTILE
ENDIF
SIF CFLAG:CP_P:1 == 9
	RETURNF CR_HOSTILE
SIF INRANGE(NO:CP_P, 200, 210)
	RETURNF CR_FOLLOWER
RETURNF CR_CAPTIVE

@CASTLE_NORMALIZE_PERSON(CP_P)
#DIM DYNAMIC CP_P
#DIM DYNAMIC CP_NEW
#DIM DYNAMIC CP_OLD
SIF CP_P < 0 || CP_P >= CHARANUM
	RETURN 0
CP_OLD = CASTLE_PERSON:CP_P:CP_ROLE
CP_NEW = CASTLE_ROLE(CP_P)
CASTLE_PERSON:CP_P:CP_ROLE = CP_NEW
SELECTCASE CP_NEW
CASE CR_MASTER
	CASTLE_PERSON:CP_P:CP_HOME = CL_CHAMBER
	CASTLE_PERSON:CP_P:CP_WORK = 0
CASE CR_FAMILY
	IF CP_OLD != CR_FAMILY || CASTLE_PERSON:CP_P:CP_HOME == CL_DUNGEON || CASTLE_PERSON:CP_P:CP_HOME == CL_CHAMBER || CFLAG:CP_P:451 < 18
		CASTLE_PERSON:CP_P:CP_HOME = CL_FAMILY
	ENDIF
	CASTLE_PERSON:CP_P:CP_ORIGIN = 0
	; 旧档的拘束活动不能让家属继续进入处置、陷阱或成人自动事件。
	IF CFLAG:CP_P:1 == 7 || CFLAG:CP_P:1 == 8
		CFLAG:CP_P:1 = 0
	ENDIF
CASE CR_HOSTILE, CR_CAPTIVE
	CASTLE_PERSON:CP_P:CP_HOME = CL_DUNGEON
	CASTLE_PERSON:CP_P:CP_WORK = 0
	CASTLE_PERSON:CP_P:CP_ORIGIN = 0
CASE CR_FOLLOWER
	SIF CASTLE_PERSON:CP_P:CP_HOME < 1 || CASTLE_PERSON:CP_P:CP_HOME > 7
		CASTLE_PERSON:CP_P:CP_HOME = CL_QUARTERS
ENDSELECT
SIF CFLAG:CP_P:451 < 18 || CASTLE_PERSON:CP_P:CP_WORK < 0 || CASTLE_PERSON:CP_P:CP_WORK > CL_LAST
	CASTLE_PERSON:CP_P:CP_WORK = 0
SIF CASTLE_PERSON:CP_P:CP_HOME < 1 || CASTLE_PERSON:CP_P:CP_HOME > 7
	CASTLE_PERSON:CP_P:CP_HOME = CP_NEW == CR_FAMILY ? CL_FAMILY # CL_DUNGEON
; 旧档不能靠活动标记把未归顺者或年幼家属派出去。
IF CP_P != MASTER && (CFLAG:CP_P:1 == 3 || CFLAG:CP_P:1 == 12) && (CP_NEW == CR_CAPTIVE || CFLAG:CP_P:451 < 18)
	CALL CASTLE_CANCEL_TASK(CP_P)
ENDIF
RETURN 1

@CASTLE_CANCEL_TASK(CP_P)
#DIM DYNAMIC CP_P
#DIM DYNAMIC CP_I
SIF CP_P <= 0 || CP_P >= CHARANUM || CP_P == MASTER
	RETURN 0
FOR CP_I, 0, CHARANUM
	SIF CFLAG:CP_I:531 == CP_P
		CFLAG:CP_I:531 = 0
	SIF CFLAG:CP_I:532 == CP_P
		CFLAG:CP_I:532 = 0
	IF CFLAG:CP_I:533 == CP_P
		CFLAG:CP_I:533 = 0
		CFLAG:CP_I:530 = 0
	ENDIF
NEXT
CFLAG:CP_P:531 = 0
CFLAG:CP_P:532 = 0
CFLAG:CP_P:533 = 0
CFLAG:CP_P:530 = 0
CFLAG:CP_P:534 = 0
CFLAG:CP_P:1 = 0
RETURN 1

@CASTLE_INTERCEPT_REASON(CP_P)
#FUNCTION
#DIM DYNAMIC CP_P
SIF CASTLE_ACCESS_REASON(CP_P, CA_DEPLOY)
	RETURNF 1
SIF TALENT:CP_P:153 && GETBIT(FLAG:5,10) == 0
	RETURNF 2
SIF EX_TALENT:CP_P:1 && EX_TALENT:CP_P:2 == 0
	RETURNF 3
SIF EX_TALENT:CP_P:2 && GETBIT(EX_FLAG:9000,1) == 0
	RETURNF 4
RETURNF 0

@CASTLE_ACCESS_REASON(CP_P, CP_ACTION)
#FUNCTION
#DIM DYNAMIC CP_P
#DIM DYNAMIC CP_ACTION
#DIM DYNAMIC CP_ROLE_NOW
SIF CP_P < 0 || CP_P >= CHARANUM || CP_ACTION < CA_SUPPORT || CP_ACTION > CA_RELEASE
	RETURNF 1
CP_ROLE_NOW = CASTLE_ROLE(CP_P)
IF CP_P == MASTER
	SIF CP_ACTION == CA_SUPPORT
		RETURNF 0
	RETURNF 2
ENDIF
SIF CP_ROLE_NOW == CR_HOSTILE
	RETURNF 2
SELECTCASE CP_ACTION
CASE CA_SUPPORT
	SIF CFLAG:CP_P:1 != 0 && CFLAG:CP_P:1 != 10
		RETURNF 3
	SIF CASTLE_WHERE(CP_P) <= 0 || CASTLE_WHERE(CP_P) != CASTLE_STATE:2
		RETURNF 4
CASE CA_DEPLOY, CA_RECALL
	SIF CP_ROLE_NOW != CR_FOLLOWER && CP_ROLE_NOW != CR_FAMILY
		RETURNF 2
	SIF CFLAG:CP_P:451 < 18
		RETURNF 5
	IF CP_ACTION == CA_DEPLOY
		SIF CFLAG:CP_P:1 != 0 || BASE:CP_P:0 < 1
			RETURNF 3
	ELSE
		SIF CFLAG:CP_P:1 != 3 && CFLAG:CP_P:1 != 12
			RETURNF 3
	ENDIF
CASE CA_DISPOSE
	SIF CP_ROLE_NOW != CR_CAPTIVE || CASTLE_PROTECTED_REASON(CP_P)
		RETURNF 2
	SIF CFLAG:CP_P:1 != 0 && CFLAG:CP_P:1 != 7
		RETURNF 3
CASE CA_RELEASE
	SIF CFLAG:CP_P:1 != 7 && CFLAG:CP_P:1 != 8
		RETURNF 3
	SIF CASTLE_STATE:2 != CL_DUNGEON
		RETURNF 4
ENDSELECT
RETURNF 0

; 给旧成人事件加拒绝检查；不创建新的成人行为或文本。
@CASTLE_PROTECTED_REASON(CP_P)
#FUNCTION
#DIM DYNAMIC CP_P
SIF CP_P < 0 || CP_P >= CHARANUM || MASTER < 0 || MASTER >= CHARANUM || CP_P == MASTER
	RETURNF 1
SIF CASTLE_HAS_FAMILY(CP_P)
	RETURNF 3
RETURNF CASTLE_PRIVATE_REASON(MASTER, CP_P)

; 城内自动私密事件只接触在寝宫的成年非亲属部下。
@CASTLE_AUTO_REASON(CP_P)
#FUNCTION
#DIM DYNAMIC CP_P
SIF CASTLE_PROTECTED_REASON(CP_P)
	RETURNF 1
SIF CASTLE_ROLE(CP_P) != CR_FOLLOWER || CFLAG:CP_P:1 != 0
	RETURNF 2
SIF CASTLE_STATE:2 != CL_CHAMBER || CASTLE_WHERE(CP_P) != CL_CHAMBER
	RETURNF 3
RETURNF 0

; 解除固定只改活动，保留原身份、住处及归顺来源。
@CASTLE_RELEASE_LEGACY(CP_P)
#DIM DYNAMIC CP_P
SIF CASTLE_ACCESS_REASON(CP_P, CA_RELEASE)
	RETURN 0
CFLAG:CP_P:1 = 0
CALL CASTLE_NORMALIZE_PERSON(CP_P)
RETURN 1

; 在身份已确认后展示，旧界面不再把所有城内人物标成“可调教”。
@CASTLE_ACTIVITY_NAME(CP_P)
#FUNCTIONS
#DIM DYNAMIC CP_P
SIF CP_P < 0 || CP_P >= CHARANUM
	RETURNF "无效人物"
SELECTCASE CFLAG:CP_P:1
CASE 0
	RETURNF CASTLE_PLACE_NAME(CASTLE_WHERE(CP_P))
CASE 2
	RETURNF "敌方侵攻中"
CASE 3
	RETURNF "迎击任务中"
CASE 7, 8
	RETURNF "旧设施占用中"
CASE 9
	RETURNF "城外或被俘中"
CASE 10
	RETURNF "育儿照护中"
CASE 11
	RETURNF "未完全召唤"
CASE 12
	RETURNF "出征中"
ENDSELECT
RETURNF "旧事件处理中"

; 旧人物离城序列化追加可选字段，旧字符串仍按原字段读取。
@CASTLE_EXPORT_MEMORY(CP_P)
#FUNCTIONS
#DIM DYNAMIC CP_P
#DIM DYNAMIC CP_I
#DIMS DYNAMIC CP_MEM
CP_MEM = _CP1_
FOR CP_I, 0, 10
	SIF CP_I > 0
		CP_MEM += ","
	CP_MEM += TOSTR(CASTLE_PERSON:CP_P:CP_I)
NEXT
CP_MEM += "_"
FOR CP_I, 0, 20
	SIF CP_I > 0
		CP_MEM += ","
	CP_MEM += TOSTR(DIALOGUE_PERSON:CP_P:CP_I)
NEXT
CP_MEM += "_"
FOR CP_I, 0, 12
	SIF CP_I > 0
		CP_MEM += ","
	CP_MEM += TOSTR(DIALOGUE_SEEN:CP_P:CP_I)
NEXT
CP_MEM += "_"
FOR CP_I, 0, 12
	SIF CP_I > 0
		CP_MEM += ","
	CP_MEM += TOSTR(DIALOGUE_CHOICES:CP_P:CP_I)
NEXT
CP_MEM += "_"
FOR CP_I, 0, 1000
	SIF EX_TALENT:CP_P:CP_I
		CP_MEM += @"{CP_I},{EX_TALENT:CP_P:CP_I}/"
NEXT
CP_MEM += "_"
FOR CP_I, 0, CHARANUM
	SIF CP_I == CP_P
		CONTINUE
	SIF CASTLE_KIN_KIND(CP_P, CP_I) > 0 || CASTLE_KIN_KIND(CP_I, CP_P) > 0
		CP_MEM += @"{CASTLE_PERSON:CP_I:CP_UID},{R_GET(CP_P, CP_I)},{R_GET(CP_I, CP_P)}/"
NEXT
CP_MEM += IX_EXPORT(CP_P)
CP_MEM += CM_EXPORT(CP_P)
RETURNF CP_MEM

@CASTLE_IMPORT_MEMORY(CP_P, CP_TEXT)
#DIM DYNAMIC CP_P
#DIMS DYNAMIC CP_TEXT
#DIMS DYNAMIC CP_FIELDS, 30
#DIMS DYNAMIC CP_VALUES, 24
#DIM DYNAMIC CP_I
#DIM DYNAMIC CP_GROUP
#DIM DYNAMIC CP_EXPECT
#DIM DYNAMIC CP_COUNT
#DIM DYNAMIC CP_J
#DIMS DYNAMIC CP_EXTRA, 1001
SIF CP_P < 0 || CP_P >= CHARANUM
	RETURN 0
SPLIT CP_TEXT, "_", CP_FIELDS
CP_COUNT = RESULT
SIF RESULT < 19 || CP_FIELDS:14 != "CP1"
	RETURN 0
; 先验证所有字段长度，避免损坏的追加字段只恢复一半。
FOR CP_GROUP, 0, 4
	CP_EXPECT = CP_GROUP == 0 ? 10 # (CP_GROUP == 1 ? 20 # 12)
	SPLIT CP_FIELDS:(15 + CP_GROUP), ",", CP_VALUES
	SIF RESULT != CP_EXPECT
		RETURN 0
NEXT
FOR CP_GROUP, 0, 4
	CP_EXPECT = CP_GROUP == 0 ? 10 # (CP_GROUP == 1 ? 20 # 12)
	SPLIT CP_FIELDS:(15 + CP_GROUP), ",", CP_VALUES
	FOR CP_I, 0, CP_EXPECT
		SELECTCASE CP_GROUP
		CASE 0
			CASTLE_PERSON:CP_P:CP_I = TOINT(CP_VALUES:CP_I)
		CASE 1
			DIALOGUE_PERSON:CP_P:CP_I = TOINT(CP_VALUES:CP_I)
		CASE 2
			DIALOGUE_SEEN:CP_P:CP_I = TOINT(CP_VALUES:CP_I)
		CASE 3
			DIALOGUE_CHOICES:CP_P:CP_I = TOINT(CP_VALUES:CP_I)
		ENDSELECT
	NEXT
NEXT
IF CP_COUNT >= 20 && STRLENS(CP_FIELDS:19) > 0
	SPLIT CP_FIELDS:19, "/", CP_EXTRA
	CP_COUNT = RESULT
	FOR CP_I, 0, CP_COUNT
		SIF STRLENS(CP_EXTRA:CP_I) == 0
			CONTINUE
		SPLIT CP_EXTRA:CP_I, ",", CP_VALUES
		SIF RESULT != 2
			CONTINUE
		CP_GROUP = TOINT(CP_VALUES:0)
		SIF CP_GROUP >= 0 && CP_GROUP < 1000
			EX_TALENT:CP_P:CP_GROUP = TOINT(CP_VALUES:1)
	NEXT
ENDIF
SPLIT CP_TEXT, "_", CP_FIELDS
IF RESULT >= 21 && STRLENS(CP_FIELDS:20) > 0
	CALL RELATION_REBUILD
	SPLIT CP_FIELDS:20, "/", CP_EXTRA
	CP_COUNT = RESULT
	FOR CP_I, 0, CP_COUNT
		SIF STRLENS(CP_EXTRA:CP_I) == 0
			CONTINUE
		SPLIT CP_EXTRA:CP_I, ",", CP_VALUES
		SIF RESULT != 3
			CONTINUE
		FOR CP_J, 0, CHARANUM
			IF CP_J != CP_P && CASTLE_PERSON:CP_J:CP_UID == TOINT(CP_VALUES:0)
				CALL R_SET(CP_P, CP_J, TOINT(CP_VALUES:1))
				CALL R_SET(CP_J, CP_P, TOINT(CP_VALUES:2))
				BREAK
			ENDIF
		NEXT
	NEXT
ENDIF
CALL IX_IMPORT(CP_P, CP_TEXT)
CALL CM_IMPORT(CP_P, CP_TEXT)
RETURN 1
