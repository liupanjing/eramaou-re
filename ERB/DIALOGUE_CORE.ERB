; 对话运行逻辑。剧本位于DIALOGUE_STORIES；日常与性格回应位于DIALOGUE_DAILY。
@DIALOGUE_SYNC(DL_P)
#DIM DYNAMIC DL_P
#DIM DYNAMIC DL_LIFE
SIF DL_P < 0 || DL_P >= CHARANUM || DL_P == MASTER
	RETURN
IF DIALOGUE_PERSON:DL_P:DP_VERSION >= 2
	; 保留原作自负的性格；被俘后的戒备与归顺态度由独立规则决定。
	SIF DIALOGUE_PERSON:DL_P:DP_SPECIAL == 170
		DIALOGUE_PERSON:DL_P:DP_TEMPER = 4
	SIF DIALOGUE_PERSON:DL_P:DP_STORY_PACK == 0
		DIALOGUE_PERSON:DL_P:DP_STORY_PACK = DIALOGUE_PACK(DL_P) + 1
	RETURN
ENDIF
IF DIALOGUE_PERSON:DL_P:DP_VERSION == 1
	; 有过正文、日常或原作初回事件的人，不在读档后重新自我介绍。
	SIF DIALOGUE_PERSON:DL_P:DP_LAST > 0 || DIALOGUE_PERSON:DL_P:DP_EVENT > 0 || CFLAG:DL_P:201 > 0 || CFLAG:DL_P:10 > 0
		DIALOGUE_PERSON:DL_P:DP_MET = 1
	FOR DL_LIFE, 1, 11
		SIF DIALOGUE_SEEN:DL_P:DL_LIFE > 0
			DIALOGUE_PERSON:DL_P:DP_MET = 1
	NEXT
	IF DIALOGUE_PERSON:DL_P:DP_MET || DIALOGUE_PERSON:DL_P:DP_CHAPTER > 0
		DIALOGUE_PERSON:DL_P:DP_STORY_PACK = DIALOGUE_LEGACY_PACK(DL_P) + 1
	ELSE
		DIALOGUE_PERSON:DL_P:DP_STORY_PACK = DIALOGUE_PACK(DL_P) + 1
	ENDIF
	DIALOGUE_PERSON:DL_P:DP_VERSION = 2
	RETURN
ENDIF
DIALOGUE_PERSON:DL_P:DP_VERSION = 2
SIF CFLAG:DL_P:201 > 0 || CFLAG:DL_P:10 > 0
	DIALOGUE_PERSON:DL_P:DP_MET = 1
DL_LIFE = TALENT:DL_P:315 % 1000
SELECTCASE DL_LIFE
CASE 19
	DIALOGUE_PERSON:DL_P:DP_ORIGIN = 1
CASE 3, 4, 7, 9, 18, 20, 21
	DIALOGUE_PERSON:DL_P:DP_ORIGIN = 2
CASE 1, 17
	DIALOGUE_PERSON:DL_P:DP_ORIGIN = 3
CASE 8
	DIALOGUE_PERSON:DL_P:DP_ORIGIN = 4
CASE 2, 10, 11, 12, 13
	DIALOGUE_PERSON:DL_P:DP_ORIGIN = 5
CASE 6, 14, 15, 16
	DIALOGUE_PERSON:DL_P:DP_ORIGIN = 6
CASEELSE
	; 背景不明时只确定话题方向，不编造家庭或军籍。
	IF TALENT:DL_P:205 || TALENT:DL_P:200 || TALENT:DL_P:208
		DIALOGUE_PERSON:DL_P:DP_ORIGIN = 1
	ELSEIF TALENT:DL_P:201
		DIALOGUE_PERSON:DL_P:DP_ORIGIN = 3
	ELSEIF TALENT:DL_P:202 || TALENT:DL_P:206
		DIALOGUE_PERSON:DL_P:DP_ORIGIN = 5
	ELSE
		DIALOGUE_PERSON:DL_P:DP_ORIGIN = 2
	ENDIF
ENDSELECT
IF TALENT:DL_P:162 || TALENT:DL_P:10
	DIALOGUE_PERSON:DL_P:DP_TEMPER = 2
ELSEIF TALENT:DL_P:164 || TALENT:DL_P:172 || TALENT:DL_P:22
	DIALOGUE_PERSON:DL_P:DP_TEMPER = 3
ELSEIF TALENT:DL_P:163 || TALENT:DL_P:174 || TALENT:DL_P:15 || TALENT:DL_P:16
	DIALOGUE_PERSON:DL_P:DP_TEMPER = 4
ELSEIF TALENT:DL_P:12 || TALENT:DL_P:11
	DIALOGUE_PERSON:DL_P:DP_TEMPER = 1
ELSEIF TALENT:DL_P:13 || TALENT:DL_P:160
	DIALOGUE_PERSON:DL_P:DP_TEMPER = 5
ELSEIF TALENT:DL_P:161
	DIALOGUE_PERSON:DL_P:DP_TEMPER = 6
ENDIF
; 专属标识优先，不根据姓名或当前住处识别人。
IF TALENT:DL_P:170
	DIALOGUE_PERSON:DL_P:DP_SPECIAL = 170
	DIALOGUE_PERSON:DL_P:DP_TEMPER = 4
	DIALOGUE_PERSON:DL_P:DP_ORIGIN = 3
ENDIF
DIALOGUE_PERSON:DL_P:DP_VARIANT = CASTLE_PERSON:DL_P:CP_UID % 3
; 未完成的旧游说仅转为初始印象，不能跳过剧情与约定；既有归顺保留。
DIALOGUE_PERSON:DL_P:DP_TRUST = LIMIT(CASTLE_PERSON:DL_P:CP_PERSUADE / 3, 0, 30)
DIALOGUE_PERSON:DL_P:DP_AGREE = LIMIT(CASTLE_PERSON:DL_P:CP_PERSUADE / 2, 0, 50)
IF CASTLE_PERSON:DL_P:CP_ROLE == CR_FOLLOWER && CASTLE_PERSON:DL_P:CP_ORIGIN == 3
	DIALOGUE_PERSON:DL_P:DP_CHAPTER = 4
	DIALOGUE_PERSON:DL_P:DP_PROMISE = 2
	DIALOGUE_PERSON:DL_P:DP_ISSUE = 1
	DIALOGUE_PERSON:DL_P:DP_DEAL = 1
ENDIF
DIALOGUE_PERSON:DL_P:DP_STORY_PACK = DIALOGUE_PACK(DL_P) + 1
RETURN

@DIALOGUE_PACK(DL_P)
#FUNCTION
#DIM DYNAMIC DL_P
#DIM DYNAMIC DL_PROFILE
SIF DIALOGUE_PERSON:DL_P:DP_STORY_PACK > 0
	RETURNF DIALOGUE_PERSON:DL_P:DP_STORY_PACK - 1
DL_PROFILE = DIALOGUE_PROFILE(DL_P)
SIF DL_PROFILE == 167 || DL_PROFILE == 168 || DL_PROFILE == 169 || DL_PROFILE == 171 || DL_PROFILE == 101 || DL_PROFILE == 102 || DL_PROFILE == 103 || DL_PROFILE == 134 || DL_PROFILE == 150
	RETURNF DL_PROFILE
SIF DL_PROFILE == 170
	RETURNF 10
SIF DIALOGUE_PERSON:DL_P:DP_ORIGIN == 1 && DIALOGUE_PERSON:DL_P:DP_TEMPER == 1
	RETURNF 1
SIF DIALOGUE_PERSON:DL_P:DP_ORIGIN == 2 && DIALOGUE_PERSON:DL_P:DP_TEMPER == 2
	RETURNF 2
SIF DIALOGUE_PERSON:DL_P:DP_ORIGIN == 3 && DIALOGUE_PERSON:DL_P:DP_TEMPER == 3
	RETURNF 3
RETURNF 0

; v1已发生的事件仍使用原包解释旧选择，不把同一编号套成新角色台词。
@DIALOGUE_LEGACY_PACK(DL_P)
#FUNCTION
#DIM DYNAMIC DL_P
SIF DIALOGUE_PERSON:DL_P:DP_SPECIAL == 170
	RETURNF 10
SIF DIALOGUE_PERSON:DL_P:DP_ORIGIN == 1 && DIALOGUE_PERSON:DL_P:DP_TEMPER == 1
	RETURNF 1
SIF DIALOGUE_PERSON:DL_P:DP_ORIGIN == 2 && DIALOGUE_PERSON:DL_P:DP_TEMPER == 2
	RETURNF 2
SIF DIALOGUE_PERSON:DL_P:DP_ORIGIN == 3 && DIALOGUE_PERSON:DL_P:DP_TEMPER == 3
	RETURNF 3
RETURNF 0

@DIALOGUE_ELIGIBLE(DL_P, DL_NEGOTIATE = 0)
#FUNCTION
#DIM DYNAMIC DL_P
#DIM DYNAMIC DL_NEGOTIATE
SIF DIALOGUE_PROFILE(DL_P) == 165 || DIALOGUE_PROFILE(DL_P) == 104
	RETURNF 0
SIF CASTLE_PRIVATE_REASON(MASTER, DL_P) != 0
	RETURNF 0
SIF EX_TALENT:DL_P:2 || (CASTLE_PERSON:DL_P:CP_ROLE != CR_CAPTIVE && CASTLE_PERSON:DL_P:CP_ROLE != CR_FOLLOWER)
	RETURNF 0
SIF CFLAG:DL_P:1 != 0 || CASTLE_WHERE(DL_P) == 0 || CASTLE_WHERE(DL_P) != CASTLE_STATE:2
	RETURNF 0
IF DL_NEGOTIATE
	SIF CASTLE_PERSON:DL_P:CP_ROLE != CR_CAPTIVE || CASTLE_STATE:2 != CL_DUNGEON
		RETURNF 0
ENDIF
RETURNF 1

; 普通面对面交谈独立于成年、非亲属的归顺交涉规则。
@DIALOGUE_CHAT_ELIGIBLE(DL_P)
#FUNCTION
#DIM DYNAMIC DL_P
SIF DL_P < 0 || DL_P >= CHARANUM || DL_P == MASTER
	RETURNF 0
SIF CFLAG:DL_P:1 != 0 || CASTLE_WHERE(DL_P) == 0 || CASTLE_WHERE(DL_P) != CASTLE_STATE:2
	RETURNF 0
RETURNF CASTLE_PERSON:DL_P:CP_ROLE == CR_CAPTIVE || CASTLE_PERSON:DL_P:CP_ROLE == CR_FOLLOWER || CASTLE_PERSON:DL_P:CP_ROLE == CR_FAMILY

@DIALOGUE_READY(DL_P)
#FUNCTION
#DIM DYNAMIC DL_P
SIF DL_P < 0 || DL_P >= CHARANUM || DL_P == MASTER
	RETURNF 0
SIF CASTLE_PRIVATE_REASON(MASTER, DL_P) != 0 || EX_TALENT:DL_P:2
	RETURNF 0
SIF CASTLE_PERSON:DL_P:CP_ROLE != CR_CAPTIVE
	RETURNF 0
SIF DIALOGUE_PROFILE(DL_P) == 165 || DIALOGUE_PROFILE(DL_P) == 104
	RETURNF 0
RETURNF DIALOGUE_PERSON:DL_P:DP_CHAPTER >= 4 && DIALOGUE_PERSON:DL_P:DP_TRUST >= 40 && DIALOGUE_PERSON:DL_P:DP_AGREE >= 40 && DIALOGUE_PERSON:DL_P:DP_ISSUE && DIALOGUE_PERSON:DL_P:DP_PROMISE == 2 && DIALOGUE_PERSON:DL_P:DP_DEAL

@DIALOGUE_CHOOSE(DL_MAX)
#DIM DYNAMIC DL_MAX
#DIM DYNAMIC DL_PICK
$DL_PICK
INPUT
DL_PICK = RESULT
SIF DL_PICK >= 0 && DL_PICK <= DL_MAX
	RETURN DL_PICK
PRINTL 请选择屏幕上的编号。
GOTO DL_PICK

@DIALOGUE_STATUS(DL_P)
#DIM DYNAMIC DL_P
CALL DIALOGUE_SYNC(DL_P)
IF DIALOGUE_ELIGIBLE(DL_P) == 0
	PRINTL 可以进行日常交谈，了解生活近况与需要帮助的事情。
	RETURN
ENDIF
PRINTFORML 交谈：信任{DIALOGUE_PERSON:DL_P:DP_TRUST}／100　归顺意向{DIALOGUE_PERSON:DL_P:DP_AGREE}／100
PRINTFORML 当前态度：%DIALOGUE_ATTITUDE_NAME(DL_P)%
PRINTFORML 交涉事件：{DIALOGUE_PERSON:DL_P:DP_CHAPTER}／4　魔王魅力评分：{CASTLE_CHARM()}／100
IF CASTLE_PERSON:DL_P:CP_ROLE == CR_FOLLOWER
	PRINTL 已是魔王城成员，可以继续日常交谈或重谈以前的话题。
	RETURN
ENDIF
IF DIALOGUE_PERSON:DL_P:DP_PROMISE == 1
	PRINTL 约定：物资尚未送达。可在交谈菜单中兑现（100资金、1城务行动）。
ELSEIF DIALOGUE_PERSON:DL_P:DP_PROMISE == 2
	PRINTL 约定：物资已交到本人手中。
ENDIF
IF DIALOGUE_READY(DL_P)
	PRINTL 对方已在交涉中同意加入，可在人员详情确认归顺。
ELSE
	PRINTL 对话路线需要完成交涉事件、兑现约定，并在最后谈妥加入条件。
ENDIF
RETURN

@DIALOGUE_MAIN(DL_P)
#DIM DYNAMIC DL_P
#DIM DYNAMIC DL_PICK
#DIM DYNAMIC DL_REVIEW
CALL CASTLE_SYNC
IF DIALOGUE_CHAT_ELIGIBLE(DL_P) == 0
	PRINTW 请先前往对方所在设施，再与在场成员交谈。
	RETURN 0
ENDIF
CALL DIALOGUE_SCENE_HEADER(DL_P, "交谈")
CALL DIALOGUE_OPEN(DL_P)
$DL_MENU
CALL DIALOGUE_STATUS(DL_P)
PRINTL 交谈：1行动／每人每时段一次。查看记录与返回不消耗行动。
IF DIALOGUE_ELIGIBLE(DL_P) && CASTLE_PERSON:DL_P:CP_ROLE == CR_CAPTIVE && DIALOGUE_PERSON:DL_P:DP_CHAPTER < 3
	CALL DIALOGUE_OPTION(1, DIALOGUE_EVENT_TITLE(DIALOGUE_PACK(DL_P), DIALOGUE_PERSON:DL_P:DP_CHAPTER + 1))
ENDIF
CALL DIALOGUE_OPTION(2, "聊聊近况与日常生活")
SIF DIALOGUE_HAS_HISTORY(DL_P)
	CALL DIALOGUE_OPTION(3, "再谈以前的话题")
SIF DIALOGUE_PERSON:DL_P:DP_PROMISE == 1
	CALL DIALOGUE_OPTION(4, "送去答应的物资（100资金、1行动）")
SIF DIALOGUE_ELIGIBLE(DL_P) && CASTLE_PERSON:DL_P:CP_ROLE == CR_CAPTIVE && DIALOGUE_PERSON:DL_P:DP_CHAPTER >= 3 && DIALOGUE_PERSON:DL_P:DP_DEAL == 0
	CALL DIALOGUE_OPTION(5, "询问是否愿意归顺")
CALL DIALOGUE_OPTION(6, "回顾交谈记录")
CALL DIALOGUE_OPTION(0, "返回")
INPUT
DL_PICK = RESULT
SIF DL_PICK == 0 || DL_PICK == 999
	RETURN 0
SELECTCASE DL_PICK
CASE 1
	SIF DIALOGUE_ELIGIBLE(DL_P) == 0 || CASTLE_PERSON:DL_P:CP_ROLE != CR_CAPTIVE || DIALOGUE_PERSON:DL_P:DP_CHAPTER >= 3
		GOTO DL_MENU
	CALL DIALOGUE_SESSION(DL_P, DIALOGUE_PERSON:DL_P:DP_CHAPTER + 1)
	SIF RESULT
		RETURN 1
CASE 2
	CALL DIALOGUE_SESSION(DL_P, 10)
	SIF RESULT
		RETURN 1
CASE 3
	SIF DIALOGUE_HAS_HISTORY(DL_P) == 0
		GOTO DL_MENU
	PRINTL 重谈会结合以前的回答，关系收益较少；不会重复领取物资或重置约定。
	FOR DL_REVIEW, 1, MIN(3, DIALOGUE_PERSON:DL_P:DP_CHAPTER) + 1
		PRINTFORML [{DL_REVIEW}] %DIALOGUE_EVENT_TITLE(DIALOGUE_PACK(DL_P), DL_REVIEW)%
	NEXT
	PRINTL [0] 取消
	CALL DIALOGUE_CHOOSE(MIN(3, DIALOGUE_PERSON:DL_P:DP_CHAPTER))
	IF RESULT > 0
		CALL DIALOGUE_SESSION(DL_P, RESULT)
		SIF RESULT
			RETURN 1
	ENDIF
CASE 4
	CALL DIALOGUE_FULFILL(DL_P)
	SIF RESULT
		RETURN 1
CASE 5
	CALL DIALOGUE_SESSION(DL_P, 4)
	SIF RESULT
		RETURN 1
CASE 6
	CALL DIALOGUE_RECAP(DL_P)
ENDSELECT
GOTO DL_MENU

; 所有状态检查先于扣行动；一场会话的两个选择结算一次。
@DIALOGUE_SESSION(DL_P, DL_EVENT)
#DIM DYNAMIC DL_P
#DIM DYNAMIC DL_EVENT
#DIM DYNAMIC DL_FIRST
#DIM DYNAMIC DL_SECOND
#DIM DYNAMIC DL_TRUST
#DIM DYNAMIC DL_AGREE
#DIM DYNAMIC DL_SUCCESS
#DIM DYNAMIC DL_BONUS
#DIM DYNAMIC DL_NEGOTIATE
CALL DIALOGUE_SYNC(DL_P)
SIF DL_EVENT != 10 && (DL_EVENT < 1 || DL_EVENT > 4)
	RETURN 0
DL_NEGOTIATE = DL_EVENT != 10
IF DL_EVENT == 10 && DIALOGUE_ELIGIBLE(DL_P) == 0
	CALL DIALOGUE_SOCIAL_SESSION(DL_P)
	RETURN RESULT
ENDIF
; 归顺后的旧话题可以在部下居所等处重谈，不重新办理归顺。
IF DL_EVENT >= 1 && DL_EVENT <= 3 && CASTLE_PERSON:DL_P:CP_ROLE == CR_FOLLOWER
	SIF DIALOGUE_SEEN:DL_P:DL_EVENT > 0 && DIALOGUE_PERSON:DL_P:DP_CHAPTER >= DL_EVENT
		DL_NEGOTIATE = 0
ENDIF
IF DIALOGUE_ELIGIBLE(DL_P, DL_NEGOTIATE) == 0
	PRINTW 日常交谈可在当前设施进行；归顺交涉需要魔王与俘虏同在地牢。
	RETURN 0
ENDIF
IF DL_EVENT != 10 && DL_EVENT > DIALOGUE_PERSON:DL_P:DP_CHAPTER + 1
	PRINTW 先谈完前面的事情，再继续这段交涉。
	RETURN 0
ENDIF
IF DL_EVENT == 4
	IF DIALOGUE_PERSON:DL_P:DP_DEAL || DIALOGUE_PERSON:DL_P:DP_CHAPTER < 3
		PRINTW 当前没有需要继续的最终交涉。
		RETURN 0
	ENDIF
	IF DIALOGUE_PERSON:DL_P:DP_TRUST < 40 || DIALOGUE_PERSON:DL_P:DP_AGREE < 40 || DIALOGUE_PERSON:DL_P:DP_PROMISE != 2 || DIALOGUE_PERSON:DL_P:DP_ISSUE == 0
		PRINTW 还需要彼此信任、认可合作，并把之前的物资约定兑现。可以重谈以前的话题。
		RETURN 0
	ENDIF
ENDIF
IF DIALOGUE_PERSON:DL_P:DP_LAST == DAY * 2 + TIME + 1
	PRINTW 本时段已经认真交谈过。让对方想一想，下个时段再继续吧。
	RETURN 0
ENDIF
CALL CASTLE_SPEND
SIF RESULT == 0
	RETURN 0
DIALOGUE_PERSON:DL_P:DP_LAST = DAY * 2 + TIME + 1
CASTLE_PERSON:DL_P:CP_LAST_PERSUADE = DAY * 2 + TIME + 1
DIALOGUE_PERSON:DL_P:DP_LAST_TOPIC = DL_EVENT
SIF DIALOGUE_PERSON:DL_P:DP_MET == 0
	CALL DIALOGUE_OPEN(DL_P)
IF DL_EVENT == 10
	CALL DIALOGUE_DAILY(DL_P)
	RETURN 1
ENDIF
IF DIALOGUE_SEEN:DL_P:DL_EVENT > 0
	PRINTL 你们重新谈起了这个话题。对方还记得上次的回答，等你把想法说明白。
ENDIF
IF DIALOGUE_PACK(DL_P) == 0
	CALL DIALOGUE_ORIGIN_LINE(DL_P)
	CALL DIALOGUE_VOICE(DL_P)
ENDIF
CALL DIALOGUE_STORY(DL_P, DIALOGUE_PACK(DL_P), DL_EVENT)
DL_FIRST = RESULT:1
DL_SECOND = RESULT:2
DL_TRUST = RESULT:3
DL_AGREE = RESULT:4
DL_SUCCESS = RESULT:5
DIALOGUE_PERSON:DL_P:DP_EVENT = DL_EVENT
DIALOGUE_PERSON:DL_P:DP_CHOICE1 = DL_FIRST
DIALOGUE_PERSON:DL_P:DP_CHOICE2 = DL_SECOND
IF RESULT:0 == 0
	PRINTL 你暂时结束了这次交谈，尚未谈妥的事情留待下次继续。本次行动已使用。
	RETURN 1
ENDIF
DIALOGUE_CHOICES:DL_P:(DL_EVENT * 2) = DL_FIRST
DIALOGUE_CHOICES:DL_P:(DL_EVENT * 2 + 1) = DL_SECOND
IF DIALOGUE_SEEN:DL_P:DL_EVENT > 0
	DL_TRUST /= 3
	DL_AGREE /= 3
ENDIF
; 魅力只温和增强说得有依据的回答，不把冒犯的选择变成正确答案。
DL_BONUS = MIN(3, CASTLE_CHARM() / 30)
SIF DL_TRUST > 0
	DL_TRUST += DL_BONUS
SIF DL_AGREE > 0
	DL_AGREE += DL_BONUS
DIALOGUE_PERSON:DL_P:DP_TRUST = LIMIT(DIALOGUE_PERSON:DL_P:DP_TRUST + DL_TRUST, 0, 100)
DIALOGUE_PERSON:DL_P:DP_AGREE = LIMIT(DIALOGUE_PERSON:DL_P:DP_AGREE + DL_AGREE, 0, 100)
DIALOGUE_SEEN:DL_P:DL_EVENT += 1
IF DL_SUCCESS && DL_EVENT == DIALOGUE_PERSON:DL_P:DP_CHAPTER + 1
	DIALOGUE_PERSON:DL_P:DP_CHAPTER = DL_EVENT
	IF DL_EVENT == 3
		DIALOGUE_PERSON:DL_P:DP_ISSUE = 1
		SIF DIALOGUE_PERSON:DL_P:DP_PROMISE == 0
			DIALOGUE_PERSON:DL_P:DP_PROMISE = 1
	ELSEIF DL_EVENT == 4
		DIALOGUE_PERSON:DL_P:DP_DEAL = 1
	ENDIF
ELSEIF DL_SUCCESS == 0
	PRINTL 分歧还没有谈妥。以后可以解释、重谈，再决定下一步。
ENDIF
; 旧进度仅作兼容显示，不再独立授予归顺资格。
CASTLE_PERSON:DL_P:CP_PERSUADE = DIALOGUE_PERSON:DL_P:DP_CHAPTER * 25
PRINTFORML 这次交谈变化：信任{DL_TRUST}　归顺意向{DL_AGREE}
IF DIALOGUE_READY(DL_P)
	PRINTW 对方已经同意加入。回到人员详情，可确认归顺与安置。
ELSE
	PRINTW 交谈告一段落。
ENDIF
RETURN 1

@DIALOGUE_FULFILL(DL_P)
#DIM DYNAMIC DL_P
IF DIALOGUE_ELIGIBLE(DL_P, 1) == 0 || DIALOGUE_PERSON:DL_P:DP_PROMISE != 1
	PRINTW 当前没有可以在这里兑现的物资约定。
	RETURN 0
ENDIF
IF MONEY < 100
	PRINTW 准备物资需要100资金。
	RETURN 0
ENDIF
CALL CASTLE_SPEND
SIF RESULT == 0
	RETURN 0
MONEY -= 100
EX_FLAG:4444 -= 100
DIALOGUE_PERSON:DL_P:DP_PROMISE = 2
IF DIALOGUE_PACK(DL_P) >= 100 || DIALOGUE_PACK(DL_P) == 10
	CALL DIALOGUE_PROSE(DL_P, DIALOGUE_CHARACTER_TEXT(DL_P, 8))
ELSEIF DIALOGUE_PACK(DL_P) == 1
	PRINTL 对方收好纸笔，确认记录可以由自己保管，才郑重地点了一下头。
ELSEIF DIALOGUE_PACK(DL_P) == 2
	PRINTL 对方把针线、布料和收纳用品一件件摆好，核对后小声道了谢。
ELSE
	PRINTL 你把清单上的基础生活和书写物资交到对方手中，由本人核对并保管。
ENDIF
PRINTW 物资已经送达，约定记为已兑现。
RETURN 1

@DIALOGUE_RECAP(DL_P)
#DIM DYNAMIC DL_P
#DIM DYNAMIC DL_EVENT
DRAWLINE
PRINTFORML 【%NAME:DL_P%的交谈记录】
CALL DIALOGUE_STATUS(DL_P)
IF DIALOGUE_PERSON:DL_P:DP_LAST_TOPIC == 10
	PRINTL 最近一次谈的是日常生活，对方记得你这次的态度。
ENDIF
IF DIALOGUE_PERSON:DL_P:DP_EVENT > 0
	FOR DL_EVENT, 1, 5
		SIF DIALOGUE_SEEN:DL_P:DL_EVENT <= 0
			CONTINUE
		PRINTFORML 话题：%DIALOGUE_EVENT_TITLE(DIALOGUE_PACK(DL_P), DL_EVENT)%
		PRINTFORML 先前说过：%DIALOGUE_CHOICE_TEXT(DIALOGUE_PACK(DL_P), DL_EVENT, 1, DIALOGUE_CHOICES:DL_P:(DL_EVENT * 2))%
		PRINTFORML 后来回答：%DIALOGUE_CHOICE_TEXT(DIALOGUE_PACK(DL_P), DL_EVENT, 2, DIALOGUE_CHOICES:DL_P:(DL_EVENT * 2 + 1))%
	NEXT
ELSE
	PRINTL 还没有深入交谈的记录。
ENDIF
PRINTW 这些记录会随人物保存。
RETURN
