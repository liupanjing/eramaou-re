; 按时段安排城内日程；刷新、查看和魔王移动不会重新安排。
@CM_VALID(CM_P)
#FUNCTION
#DIM DYNAMIC CM_P
SIF CM_P < 0 || CM_P >= CHARANUM
	RETURNF 0
SIF CM_PERSON:CM_P:CM_VERSION != 1 || CM_PERSON:CM_P:CM_STAMP != DAY * 2 + TIME + 1
	RETURNF 0
SIF CM_PERSON:CM_P:CM_HOME != CASTLE_PERSON:CM_P:CP_HOME || CM_PERSON:CM_P:CM_JOB != CASTLE_PERSON:CM_P:CP_WORK
	RETURNF 0
SIF CM_PERSON:CM_P:CM_ROLE != CASTLE_ROLE(CM_P) || CM_PERSON:CM_P:CM_UID != CASTLE_PERSON:CM_P:CP_UID
	RETURNF 0
SIF CM_PERSON:CM_P:CM_LEGACY != CFLAG:CM_P:1 || CM_PERSON:CM_P:CM_ALIVE != (BASE:CM_P:0 > 0)
	RETURNF 0
SIF CASTLE_PERSON:CM_P:CP_WORK > 0 && CM_PERSON:CM_P:CM_JOB_OPEN != EC_ACTIVE:(CASTLE_PERSON:CM_P:CP_WORK)
	RETURNF 0
SIF CM_PERSON:CM_P:CM_MODE == 3 && EC_ACTIVE:(CM_PERSON:CM_P:CM_PLACE) == 0
	RETURNF 0
SIF CM_PERSON:CM_P:CM_MODE == 3 && CFLAG:CM_P:451 < 18
	RETURNF 0
RETURNF CM_PERSON:CM_P:CM_PLACE >= 0 && CM_PERSON:CM_P:CM_PLACE <= CL_LAST

; 没有有效日程时沿用当值／居所位置，避免读旧档和手动调动时凭空游走。
@CM_BASE(CM_P)
#FUNCTION
#DIM DYNAMIC CM_P
#DIM DYNAMIC CM_JOB_ID
CM_JOB_ID = CASTLE_PERSON:CM_P:CP_WORK
IF TIME == 0 && CFLAG:CM_P:451 >= 18 && BASE:CM_P:0 > 0 && CM_JOB_ID > 0 && CM_JOB_ID <= CL_LAST
	IF CASTLE_ROLE(CM_P) == CR_FOLLOWER || CASTLE_ROLE(CM_P) == CR_FAMILY
		SIF EC_ACTIVE:CM_JOB_ID
			RETURNF CM_JOB_ID
	ENDIF
ENDIF
RETURNF CASTLE_PERSON:CM_P:CP_HOME

@CM_LOCATION(CM_P)
#FUNCTION
#DIM DYNAMIC CM_P
SIF CM_P < 0 || CM_P >= CHARANUM
	RETURNF 0
SIF CM_VALID(CM_P)
	RETURNF CM_PERSON:CM_P:CM_PLACE
RETURNF CM_BASE(CM_P)

; 永久UID和日期保证日程可重现，不消耗战斗随机数。
@CM_OUTING(CM_P)
#FUNCTION
#DIM DYNAMIC CM_P
#DIM DYNAMIC CM_START
#DIM DYNAMIC CM_I
#DIM DYNAMIC CM_DEST
CM_START = (DAY + CASTLE_PERSON:CM_P:CP_UID + DIALOGUE_PERSON:CM_P:DP_TEMPER + DIALOGUE_PERSON:CM_P:DP_ORIGIN) % 3
FOR CM_I, 0, 3
	SELECTCASE (CM_START + CM_I) % 3
	CASE 0
		CM_DEST = CL_BARRACKS
	CASE 1
		CM_DEST = CL_WORKSHOP
	CASE 2
		CM_DEST = CL_MARKET
	ENDSELECT
	SIF EC_ACTIVE:CM_DEST
		RETURNF CM_DEST
NEXT
RETURNF CASTLE_PERSON:CM_P:CP_HOME

@CM_SYNC
#DIM DYNAMIC CM_P
#DIM DYNAMIC CM_NEXT
#DIM DYNAMIC CM_KIND
#DIM DYNAMIC CM_CAN_ROAM
FOR CM_P, 0, CHARANUM
	SIF CM_VALID(CM_P)
		CONTINUE
	CM_CAN_ROAM = CM_PERSON:CM_P:CM_VERSION == 1 && CM_PERSON:CM_P:CM_STAMP != DAY * 2 + TIME + 1
	CM_NEXT = CM_BASE(CM_P)
	CM_KIND = 2
	IF CASTLE_ROLE(CM_P) == CR_CAPTIVE || CASTLE_ROLE(CM_P) == CR_HOSTILE
		CM_NEXT = CL_DUNGEON
		CM_KIND = 0
	ELSEIF TIME == 0 && CASTLE_PERSON:CM_P:CP_WORK > 0 && CM_NEXT == CASTLE_PERSON:CM_P:CP_WORK
		CM_KIND = 1
	ELSEIF CM_CAN_ROAM && (TIME == 1 || CASTLE_PERSON:CM_P:CP_WORK == 0) && CASTLE_ROLE(CM_P) == CR_FOLLOWER && CFLAG:CM_P:451 >= 18 && BASE:CM_P:0 > 0 && CFLAG:CM_P:1 == 0
		; 每隔一个空闲时段外出活动；其余时段留在居所休息。
		IF (DAY + CASTLE_PERSON:CM_P:CP_UID + TIME) % 2 == 0
			CM_NEXT = CM_OUTING(CM_P)
			SIF CM_NEXT != CASTLE_PERSON:CM_P:CP_HOME
				CM_KIND = 3
		ENDIF
	ENDIF
	CM_PERSON:CM_P:CM_VERSION = 1
	CM_PERSON:CM_P:CM_STAMP = DAY * 2 + TIME + 1
	CM_PERSON:CM_P:CM_PLACE = CM_NEXT
	CM_PERSON:CM_P:CM_MODE = CM_KIND
	CM_PERSON:CM_P:CM_HOME = CASTLE_PERSON:CM_P:CP_HOME
	CM_PERSON:CM_P:CM_JOB = CASTLE_PERSON:CM_P:CP_WORK
	CM_PERSON:CM_P:CM_ROLE = CASTLE_ROLE(CM_P)
	CM_PERSON:CM_P:CM_UID = CASTLE_PERSON:CM_P:CP_UID
	CM_PERSON:CM_P:CM_JOB_OPEN = 0
	SIF CASTLE_PERSON:CM_P:CP_WORK > 0
		CM_PERSON:CM_P:CM_JOB_OPEN = EC_ACTIVE:(CASTLE_PERSON:CM_P:CP_WORK)
	CM_PERSON:CM_P:CM_LEGACY = CFLAG:CM_P:1
	CM_PERSON:CM_P:CM_ALIVE = BASE:CM_P:0 > 0
NEXT
RETURN

@CM_ACTIVITY(CM_P)
#FUNCTIONS
#DIM DYNAMIC CM_P
SIF CM_P < 0 || CM_P >= CHARANUM
	RETURNF ""
SIF CM_P == MASTER
	RETURNF "巡视"
SIF CASTLE_WHERE(CM_P) == 0
	RETURNF "城外或任务中"
SIF CFLAG:CM_P:1 == 10
	RETURNF "育儿照护"
SIF CFLAG:CM_P:1 == 7 || CFLAG:CM_P:1 == 8 || CASTLE_ROLE(CM_P) == CR_CAPTIVE
	RETURNF "留在地牢"
SIF CASTLE_STATE:6 > 0 && CASTLE_PERSON:CM_P:CP_UID == CASTLE_STATE:6
	RETURNF "临时来访"
IF CM_VALID(CM_P)
	SELECTCASE CM_PERSON:CM_P:CM_MODE
	CASE 1
		RETURNF "当值"
	CASE 3
		SELECTCASE CM_PERSON:CM_P:CM_PLACE
		CASE CL_BARRACKS
			RETURNF "自主训练"
		CASE CL_WORKSHOP
			RETURNF "研习"
		CASE CL_MARKET
			RETURNF "闲逛采购"
		ENDSELECT
	ENDSELECT
ENDIF
SIF CFLAG:CM_P:451 < 18
	RETURNF "居所日常"
RETURNF "休息"

; IX1之后追加可选CM1字段，旧CP1和IX1内容不变。
@CM_EXPORT(CM_P)
#FUNCTIONS
#DIM DYNAMIC CM_P
#DIM DYNAMIC CM_I
#DIMS DYNAMIC CM_TEXT
CM_TEXT = _CM1_
FOR CM_I, 0, 11
	SIF CM_I > 0
		CM_TEXT += ","
	CM_TEXT += TOSTR(CM_PERSON:CM_P:CM_I)
NEXT
RETURNF CM_TEXT

@CM_IMPORT(CM_P, CM_TEXT)
#DIM DYNAMIC CM_P
#DIMS DYNAMIC CM_TEXT
#DIMS DYNAMIC CM_FIELDS, 30
#DIMS DYNAMIC CM_VALUES, 11
#DIM DYNAMIC CM_TEMP, 11
#DIM DYNAMIC CM_I
SIF CM_P < 0 || CM_P >= CHARANUM
	RETURN 0
SPLIT CM_TEXT, "_", CM_FIELDS
SIF RESULT < 27 || CM_FIELDS:25 != "CM1"
	RETURN 0
SPLIT CM_FIELDS:26, ",", CM_VALUES
SIF RESULT != 11
	RETURN 0
FOR CM_I, 0, 11
	SIF ISNUMERIC(CM_VALUES:CM_I) == 0
		RETURN 0
	CM_TEMP:CM_I = TOINT(CM_VALUES:CM_I)
	SIF CM_TEMP:CM_I < 0
		RETURN 0
NEXT
SIF CM_TEMP:CM_VERSION > 1 || CM_TEMP:CM_PLACE > CL_LAST || CM_TEMP:CM_MODE > 3 || CM_TEMP:CM_JOB > CL_LAST
	RETURN 0
FOR CM_I, 0, 11
	CM_PERSON:CM_P:CM_I = CM_TEMP:CM_I
NEXT
RETURN 1
