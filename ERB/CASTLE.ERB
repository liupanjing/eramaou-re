; 魔王城：原生 Emuera 设施、人员、行动与旧系统适配。
; 保留上午/下午及旧 TURNEND 结算，每个时段三次城务行动。

@CASTLE_SYNC
#DIM DYNAMIC CS_I
#DIM DYNAMIC CS_J
#DIM DYNAMIC CS_NEXT_ID
#DIM DYNAMIC CS_ROLE
#DIM DYNAMIC CS_STAMP
#DIM DYNAMIC CS_OLD_VERSION
#DIM DYNAMIC CS_GUEST_FOUND
SIF CHARANUM <= 0
	RETURN
CS_OLD_VERSION = CASTLE_STATE:0
IF CS_OLD_VERSION == 0
	CASTLE_STATE:0 = 3
	CASTLE_STATE:1 = 1
	CASTLE_STATE:2 = CL_THRONE
	CASTLE_STATE:3 = -1
	FOR CS_I, 1, 8
		CASTLE_LEVEL:CS_I = 1
	NEXT
ENDIF
SIF CS_OLD_VERSION < 3
	CASTLE_STATE:0 = 3
; 导入的人物可能携带更大的UID，先推进计数器，再处理重复身份。
CS_NEXT_ID = MAX(1, CASTLE_STATE:1)
FOR CS_I, 0, CHARANUM
	CS_NEXT_ID = MAX(CS_NEXT_ID, CASTLE_PERSON:CS_I:CP_UID + 1)
NEXT
FOR CS_I, 0, CHARANUM
	FOR CS_J, 0, CS_I
		SIF CASTLE_PERSON:CS_I:CP_UID > 0 && CASTLE_PERSON:CS_I:CP_UID == CASTLE_PERSON:CS_J:CP_UID
			CASTLE_PERSON:CS_I:CP_UID = 0
	NEXT
	IF CASTLE_PERSON:CS_I:CP_UID <= 0
		CASTLE_PERSON:CS_I:CP_UID = CS_NEXT_ID
		CS_NEXT_ID += 1
	ENDIF
NEXT
CASTLE_STATE:1 = CS_NEXT_ID
CALL RELATION_REBUILD
FOR CS_I, 0, CHARANUM
	IF CS_OLD_VERSION < 3
		CASTLE_PERSON:CS_I:CP_PERSUADE = 0
		CASTLE_PERSON:CS_I:CP_LAST_PERSUADE = 0
	ENDIF
	CS_ROLE = CASTLE_PERSON:CS_I:CP_ROLE
	IF CS_I == MASTER
		CASTLE_PERSON:CS_I:CP_ROLE = CR_MASTER
		CASTLE_PERSON:CS_I:CP_HOME = CL_CHAMBER
	ELSEIF CS_ROLE == 0
		IF CASTLE_HAS_FAMILY(CS_I)
			CASTLE_PERSON:CS_I:CP_ROLE = CR_FAMILY
			CASTLE_PERSON:CS_I:CP_HOME = CL_FAMILY
		ELSEIF CFLAG:CS_I:1 == 2 || CFLAG:CS_I:1 == 9
			CASTLE_PERSON:CS_I:CP_ROLE = CR_HOSTILE
			CASTLE_PERSON:CS_I:CP_HOME = CL_DUNGEON
		ELSEIF INRANGE(NO:CS_I, 200, 210)
			CASTLE_PERSON:CS_I:CP_ROLE = CR_FOLLOWER
			CASTLE_PERSON:CS_I:CP_HOME = CL_QUARTERS
			CASTLE_PERSON:CS_I:CP_ORIGIN = 1
		ELSEIF CS_OLD_VERSION == 0 && CFLAG:CS_I:0 == 2 && CASTLE_SUBMISSION_REASON(CS_I) == 0
			; 原版已成为助手且满足调教条件的成员保留其归属。
			CASTLE_PERSON:CS_I:CP_ROLE = CR_FOLLOWER
			CASTLE_PERSON:CS_I:CP_HOME = CL_QUARTERS
			CASTLE_PERSON:CS_I:CP_ORIGIN = 2
		ELSE
			CASTLE_PERSON:CS_I:CP_ROLE = CR_CAPTIVE
			CASTLE_PERSON:CS_I:CP_HOME = CL_DUNGEON
		ENDIF
	ELSEIF CS_ROLE == CR_HOSTILE && CFLAG:CS_I:1 == 0
		; 战败被捕仅迁入地牢；满足任一归顺路线后才能确认归顺。
		CASTLE_PERSON:CS_I:CP_ROLE = CR_CAPTIVE
		CASTLE_PERSON:CS_I:CP_HOME = CL_DUNGEON
	ENDIF
	; 修正v1聊天归顺。迁移后不持续用数值波动撤销已确认的归顺。
	IF CS_OLD_VERSION == 1 && CASTLE_PERSON:CS_I:CP_ROLE == CR_FOLLOWER && CASTLE_PERSON:CS_I:CP_ORIGIN == 0
		IF INRANGE(NO:CS_I, 200, 210)
			CASTLE_PERSON:CS_I:CP_ORIGIN = 1
		ELSEIF CASTLE_SUBMISSION_REASON(CS_I) == 0
			CASTLE_PERSON:CS_I:CP_ORIGIN = 2
		ELSE
			CASTLE_PERSON:CS_I:CP_ROLE = CR_CAPTIVE
			CASTLE_PERSON:CS_I:CP_HOME = CL_DUNGEON
			CASTLE_PERSON:CS_I:CP_WORK = 0
		ENDIF
	ENDIF
	; 后续确认的血缘具有优先级，不能被归顺和任命覆盖。
	IF CS_I != MASTER && CASTLE_HAS_FAMILY(CS_I)
		CASTLE_PERSON:CS_I:CP_ROLE = CR_FAMILY
		SIF CASTLE_PERSON:CS_I:CP_HOME == CL_DUNGEON
			CASTLE_PERSON:CS_I:CP_HOME = CL_FAMILY
	ENDIF
	IF CS_I != MASTER && CFLAG:CS_I:451 < 18 && CASTLE_PERSON:CS_I:CP_ROLE == CR_FAMILY
		CASTLE_PERSON:CS_I:CP_HOME = CL_FAMILY
		CASTLE_PERSON:CS_I:CP_WORK = 0
	ENDIF
	CALL CASTLE_NORMALIZE_PERSON(CS_I)
	CALL DIALOGUE_SYNC(CS_I)
NEXT
FOR CS_I, 100, 200
	CASTLE_GUARD:CS_I = LIMIT(CASTLE_GUARD:CS_I, 0, MAX(0, ITEM:CS_I))
NEXT
; 临时访客以UID定位，排序不丢失；失联、身份变化、删除后立即撤销。
FOR CS_I, 0, CHARANUM
	IF CASTLE_STATE:6 > 0 && CASTLE_PERSON:CS_I:CP_UID == CASTLE_STATE:6
		IF CASTLE_BRING_REASON(CS_I, 0) == 0
			CS_GUEST_FOUND = 1
		ENDIF
	ENDIF
NEXT
SIF CS_GUEST_FOUND == 0 || CASTLE_STATE:2 != CL_CHAMBER
	CALL CASTLE_END_VISIT
CS_STAMP = DAY * 2 + TIME
IF CASTLE_STATE:3 != CS_STAMP
	CALL CASTLE_END_VISIT
	CASTLE_STATE:3 = CS_STAMP
	CASTLE_STATE:5 = 3
ENDIF
CASTLE_STATE:2 = LIMIT(CASTLE_STATE:2, 1, 7)
RETURN

@CASTLE_PLACE_NAME(CS_P)
#FUNCTIONS
#DIM DYNAMIC CS_P
SELECTCASE CS_P
CASE CL_THRONE
	RETURNF "王座厅"
CASE CL_DUNGEON
	RETURNF "地牢"
CASE CL_QUARTERS
	RETURNF "部下居所"
CASE CL_CHAMBER
	RETURNF "魔王寝宫"
CASE CL_BARRACKS
	RETURNF "兵营"
CASE CL_FAMILY
	RETURNF "家族居所"
CASE CL_WORKSHOP
	RETURNF "工坊与研究室"
ENDSELECT
RETURNF "城外或旧系统任务中"

@CASTLE_ROLE_NAME(CS_P)
#FUNCTIONS
#DIM DYNAMIC CS_P
SELECTCASE CS_P
CASE CR_CAPTIVE
	RETURNF "俘虏"
CASE CR_FOLLOWER
	RETURNF "已归顺"
CASE CR_FAMILY
	RETURNF "家族成员"
CASE CR_HOSTILE
	RETURNF "敌方或失联"
CASE CR_MASTER
	RETURNF "魔王"
ENDSELECT
RETURNF "未登记"

@CASTLE_WHERE(CS_P)
#FUNCTION
#DIM DYNAMIC CS_P
SIF CS_P < 0 || CS_P >= CHARANUM
	RETURNF 0
SIF CS_P == MASTER
	RETURNF CASTLE_STATE:2
SIF CASTLE_ROLE(CS_P) == CR_HOSTILE
	RETURNF 0
SIF CFLAG:CS_P:1 == 10
	RETURNF CL_FAMILY
SIF CFLAG:CS_P:1 == 7 || CFLAG:CS_P:1 == 8
	RETURNF CL_DUNGEON
SIF CFLAG:CS_P:1 != 0 && CFLAG:CS_P:1 != 7
	RETURNF 0
SIF CASTLE_STATE:6 > 0 && CASTLE_PERSON:CS_P:CP_UID == CASTLE_STATE:6
	RETURNF CL_CHAMBER
SIF TIME == 0 && CASTLE_PERSON:CS_P:CP_WORK > 0 && (CASTLE_ROLE(CS_P) == CR_FOLLOWER || CASTLE_ROLE(CS_P) == CR_FAMILY) && CFLAG:CS_P:451 >= 18
	RETURNF CASTLE_PERSON:CS_P:CP_WORK
RETURNF CASTLE_PERSON:CS_P:CP_HOME

@CASTLE_FAMILY_LABEL(CS_P)
#FUNCTIONS
#DIM DYNAMIC CS_P
#DIM DYNAMIC CS_REL
SIF CS_P < 0 || CS_P >= CHARANUM || CS_P == MASTER
	RETURNF ""
SIF CASTLE_HAS_FAMILY(CS_P) == 0
	RETURNF ""
CS_REL = CASTLE_KIN_KIND(CS_P, MASTER)
IF CS_REL == 5 || CS_REL == 6
	SIF TALENT:CS_P:122
		RETURNF "魔王之子"
	RETURNF "魔王之女"
ELSEIF CS_REL > 0
	RETURNF "魔王的亲属"
ELSEIF EX_TALENT:CS_P:2
	RETURNF "城内出生的后代"
ENDIF
RETURNF "家族成员"

@CASTLE_CAPACITY(CS_P)
#FUNCTION
#DIM DYNAMIC CS_P
SELECTCASE CS_P
CASE CL_DUNGEON
	RETURNF 10 + CASTLE_LEVEL:CS_P * 5
CASE CL_QUARTERS, CL_FAMILY
	RETURNF 8 + CASTLE_LEVEL:CS_P * 4
CASE CL_CHAMBER
	RETURNF 2 + CASTLE_LEVEL:CS_P * 2
ENDSELECT
RETURNF 0

@CASTLE_RESIDENTS(CS_P)
#FUNCTION
#DIM DYNAMIC CS_P
#DIM DYNAMIC CS_I
#DIM DYNAMIC CS_N
FOR CS_I, 0, CHARANUM
	SIF CS_I != MASTER && CASTLE_PERSON:CS_I:CP_ROLE != CR_HOSTILE && CASTLE_PERSON:CS_I:CP_HOME == CS_P
		CS_N += 1
NEXT
RETURNF CS_N

@CASTLE_OCCUPANCY(CS_P)
#FUNCTION
#DIM DYNAMIC CS_P
#DIM DYNAMIC CS_I
#DIM DYNAMIC CS_N
CS_N = CASTLE_RESIDENTS(CS_P)
IF CS_P == CL_CHAMBER && CASTLE_STATE:6 > 0
	FOR CS_I, 0, CHARANUM
		IF CASTLE_PERSON:CS_I:CP_UID == CASTLE_STATE:6 && CASTLE_PERSON:CS_I:CP_HOME != CL_CHAMBER
			CS_N += 1
			BREAK
		ENDIF
	NEXT
ENDIF
RETURNF CS_N

; 非零表示禁止成人互动；与场所检查分开供手动和自动入口共用。
@CASTLE_PRIVATE_REASON(CS_ACTOR, CS_PERSON)
#FUNCTION
#DIM DYNAMIC CS_ACTOR
#DIM DYNAMIC CS_PERSON
SIF CS_ACTOR < 0 || CS_ACTOR >= CHARANUM || CS_PERSON < 0 || CS_PERSON >= CHARANUM || CS_ACTOR == CS_PERSON
	RETURNF 1
SIF CFLAG:CS_ACTOR:451 < 18 || CFLAG:CS_PERSON:451 < 18
	RETURNF 2
SIF RF_GET(CS_ACTOR, CS_PERSON) != 0 || RF_GET(CS_PERSON, CS_ACTOR) != 0
	RETURNF 3
RETURNF 0

@CASTLE_TRAIN_REASON(CS_P)
#FUNCTION
#DIM DYNAMIC CS_P
#DIM DYNAMIC CS_REASON
CS_REASON = CASTLE_PRIVATE_REASON(MASTER, CS_P)
SIF CS_REASON
	RETURNF CS_REASON
SIF CASTLE_STATE:0 == 0
	RETURNF 0
SIF CASTLE_ROLE(CS_P) == CR_FAMILY || CASTLE_ROLE(CS_P) == CR_HOSTILE
	RETURNF 3
SIF CASTLE_STATE:2 != CL_CHAMBER
	RETURNF 4
SIF CASTLE_WHERE(CS_P) != CASTLE_STATE:2
	RETURNF 5
RETURNF 0

@CASTLE_SPEND
IF CASTLE_STATE:5 <= 0
	PRINTW 本时段的城务行动已用完。可以继续巡视，或休息进入下一时段。
	RETURN 0
ENDIF
CASTLE_STATE:5 -= 1
RETURN 1

; 归顺使用原养成数值；好感1000即原界面的100%。
@CASTLE_SUBMISSION_REASON(CS_P)
#FUNCTION
#DIM DYNAMIC CS_P
SIF CS_P < 0 || CS_P >= CHARANUM || CS_P == MASTER
	RETURNF 1
SIF CFLAG:CS_P:451 < 18
	RETURNF 2
SIF EX_TALENT:CS_P:2 || RF_GET(CS_P, MASTER) != 0 || RF_GET(MASTER, CS_P) != 0
	RETURNF 3
SIF CFLAG:CS_P:10 < 1
	RETURNF 4
SIF CFLAG:CS_P:2 < CASTLE_AFFECTION_REQUIRED
	RETURNF 5
SIF MARK:CS_P:3 != 0
	RETURNF 6
SIF ABL:CS_P:10 < CASTLE_OBEDIENCE_REQUIRED
	RETURNF 7
RETURNF 0

@CASTLE_SHOW_SUBMISSION(CS_P)
#DIM DYNAMIC CS_P
PRINTL 【归顺路线一：调教培养】
PRINTFORML 好感度：{CFLAG:CS_P:2 / 10}％／至少{CASTLE_AFFECTION_REQUIRED / 10}％
PRINTFORML 反抗刻印：Lv{MARK:CS_P:3}／要求无反抗刻印
PRINTFORML 顺从：Lv{ABL:CS_P:10}／要求Lv{CASTLE_OBEDIENCE_REQUIRED}
PRINTFORML 调教经历：{CFLAG:CS_P:10}次／至少1次
PRINTL 【归顺路线二：对话交涉】
CALL DIALOGUE_STATUS(CS_P)
IF CASTLE_SUBMISSION_REASON(CS_P) == 0 || CASTLE_PERSUADE_REASON(CS_P) == 0
	PRINTL 至少一条路线已满足，可在地牢确认归顺。
ELSE
PRINTL 两条路线任选其一。调教需先带往寝宫；归顺交涉在地牢进行。
ENDIF
RETURN

; SOURCE=1仅由具名从者召唤入口使用；3为游说；其余必须满足调教条件。
@CASTLE_ACCEPT(CS_P, CS_SOURCE = 0)
#DIM DYNAMIC CS_P
#DIM DYNAMIC CS_SOURCE
SIF CS_P < 0 || CS_P >= CHARANUM || CS_P == MASTER
	RETURN 0
SIF EX_TALENT:CS_P:2 || RF_GET(CS_P, MASTER) != 0 || RF_GET(MASTER, CS_P) != 0
	RETURN 0
IF CS_SOURCE == 3
	SIF CASTLE_PERSUADE_REASON(CS_P) != 0
		RETURN 0
ELSEIF CS_SOURCE != 1
	SIF CASTLE_SUBMISSION_REASON(CS_P) != 0
		RETURN 0
ENDIF
CASTLE_PERSON:CS_P:CP_ROLE = CR_FOLLOWER
CASTLE_PERSON:CS_P:CP_HOME = CL_QUARTERS
CASTLE_PERSON:CS_P:CP_WORK = 0
CASTLE_PERSON:CS_P:CP_ORIGIN = CS_SOURCE == 1 ? 1 # (CS_SOURCE == 3 ? 3 # 2)
RETURN 1

; 原版魅力为素质而非连续数值；由话术及三个魅力相关素质导出评分。
@CASTLE_CHARM()
#FUNCTION
RETURNF LIMIT(20 + 6 * ABL:MASTER:15 + 15 * TALENT:MASTER:113 + 10 * TALENT:MASTER:91 + 20 * TALENT:MASTER:92, 0, 100)

@CASTLE_PERSUADE_GAIN(CS_P)
#FUNCTION
#DIM DYNAMIC CS_P
RETURNF LIMIT(5 + CASTLE_CHARM() / 5 - 4 * MARK:CS_P:3 - 3 * TALENT:CS_P:11 - 3 * TALENT:CS_P:12 - 2 * TALENT:CS_P:21, 1, 25)

@CASTLE_PERSUADE_REASON(CS_P)
#FUNCTION
#DIM DYNAMIC CS_P
SIF CASTLE_PRIVATE_REASON(MASTER, CS_P) != 0
	RETURNF 1
SIF EX_TALENT:CS_P:2 || CASTLE_PERSON:CS_P:CP_ROLE != CR_CAPTIVE
	RETURNF 2
SIF DIALOGUE_READY(CS_P) == 0
	RETURNF 3
RETURNF 0

@CASTLE_PERSUADE(CS_P)
#DIM DYNAMIC CS_P
IF CASTLE_BRING_REASON(CS_P, 1) != 0 || CASTLE_PERSON:CS_P:CP_ROLE != CR_CAPTIVE || CASTLE_STATE:2 != CL_DUNGEON
	PRINTW 归顺交涉需要魔王与成年俘虏同在地牢。
	RETURN 0
ENDIF
CALL DIALOGUE_MAIN(CS_P)
RETURN RESULT

; 临时带往寝宫不改写居所和职责。CHECK_LOCATION=0用于同步已保存的访客。
@CASTLE_BRING_REASON(CS_P, CS_CHECK_LOCATION = 1)
#FUNCTION
#DIM DYNAMIC CS_P
#DIM DYNAMIC CS_CHECK_LOCATION
SIF CASTLE_PRIVATE_REASON(MASTER, CS_P) != 0
	RETURNF 1
SIF EX_TALENT:CS_P:2 || CFLAG:CS_P:1 != 0
	RETURNF 2
SIF CASTLE_PERSON:CS_P:CP_ROLE != CR_CAPTIVE && CASTLE_PERSON:CS_P:CP_ROLE != CR_FOLLOWER
	RETURNF 3
SIF CS_CHECK_LOCATION && CASTLE_WHERE(CS_P) != CASTLE_STATE:2
	RETURNF 4
RETURNF 0

@CASTLE_BRING(CS_P)
#DIM DYNAMIC CS_P
IF CASTLE_BRING_REASON(CS_P) != 0
	PRINTW 请先前往符合条件的成年对象所在设施。
	RETURN 0
ENDIF
IF CASTLE_STATE:6 > 0 && CASTLE_STATE:6 != CASTLE_PERSON:CS_P:CP_UID
	PRINTW 寝宫已有临时来访者，请先送回。
	RETURN 0
ENDIF
IF CASTLE_STATE:6 != CASTLE_PERSON:CS_P:CP_UID && CASTLE_PERSON:CS_P:CP_HOME != CL_CHAMBER && CASTLE_OCCUPANCY(CL_CHAMBER) >= CASTLE_CAPACITY(CL_CHAMBER)
	PRINTW 寝宫已满，请先扩建或调整安置。
	RETURN 0
ENDIF
CASTLE_STATE:6 = CASTLE_PERSON:CS_P:CP_UID
CASTLE_STATE:2 = CL_CHAMBER
TARGET = CS_P
FLAG:1 = CS_P
ASSI = -1
FLAG:2 = -1
PRINTFORML 你带%NAME:CS_P%来到寝宫。原居所与职责保留，结束调教或离开后送回。
RETURN 1

@CASTLE_END_VISIT
CASTLE_STATE:6 = 0
RETURN

@CASTLE_DRAW
#DIM DYNAMIC CS_I
#DIM DYNAMIC CS_P
#DIM DYNAMIC CS_N
#DIM DYNAMIC CS_CAP
CALL CASTLE_SYNC
CS_P = CASTLE_STATE:2
CALL CASTLE_SCREEN_HEADER("魔王城", @"当前所在：%CASTLE_PLACE_NAME(CS_P)%　城务行动：{CASTLE_STATE:5}/3")
PRINTL 【前往设施】（城内移动与查阅不消耗时间）
FOR CS_I, 1, 8
	PRINTBUTTON @"[{CS_I+200}] %CASTLE_PLACE_NAME(CS_I)%", 21000 + CS_I
	PRINT 　
NEXT
PRINTL
DRAWLINE
SELECTCASE CS_P
CASE CL_THRONE
	PRINTL 在王座厅处理城务、人员任命和对外战争。
	PRINTBUTTON "[220] 全城名册与任命", 21120
	PRINT 　
	PRINTBUTTON "[221] 设施建设与扩建", 21121
	PRINT 　
	PRINTBUTTON "[222] 侵略与远征", 21122
	PRINT 　
	PRINTBUTTON "[223] 商店与补给", 21123
	PRINT 　

CASE CL_DUNGEON
	PRINTL 俘虏在地牢居住，可通过魅力游说归顺；调教需先带往寝宫。
	PRINTBUTTON "[220] 在场人员与归顺条件", 21100
	PRINT 　
	PRINTBUTTON "[221] 选择带往寝宫的对象", 21106
	PRINT 　
CASE CL_QUARTERS
	PRINTL 归顺者在这里生活；上午有任命的人员会前往工作地点。
	PRINTBUTTON "[220] 在场人员与安置", 21100
	PRINT 　
CASE CL_CHAMBER
	PRINTL 魔王在这里进行调教。可带来成年对象临时会面，结束后返回原居所。
	PRINTBUTTON "[220] 在场人员", 21100
	PRINT 　
	PRINTBUTTON "[221] 选择在场成年对象", 21102
	PRINT 　
	PRINTBUTTON "[222] 开始调教", 21103
	PRINT 　
	PRINTBUTTON "[223] 培养能力／消除刻印", 21104
	PRINT 　
	PRINTBUTTON "[224] 送回临时来访者", 21105
	PRINT 　
CASE CL_BARRACKS
	PRINTL 兵营管理召唤部队、地牢驻防和具名教官。普通士兵以兵种数量登记。
	PRINTBUTTON "[220] 在场人员与任命", 21100
	PRINT 　
	PRINTBUTTON "[221] 部队与驻防", 21130
	PRINT 　
	PRINTBUTTON "[222] 召唤士兵", 21131
	PRINT 　
	PRINTBUTTON "[223] 地下城防御部署", 21132
	PRINT 　
	PRINTBUTTON "[224] 召唤具名从者", 21133
	PRINT 　
CASE CL_FAMILY
	PRINTL 家族成员在这里生活。可以查看亲属关系、陪伴和安排成年成员的职责。
	PRINTBUTTON "[220] 家族成员", 21140
	PRINT 　
CASE CL_WORKSHOP
	PRINTL 研究室与工坊提供原有的研究、装备和服装服务。
	PRINTBUTTON "[220] 在场人员与任命", 21100
	PRINT 　
	PRINTBUTTON "[221] 实验室", 21150
	PRINT 　
	PRINTBUTTON "[222] 服装工坊", 21151
	PRINT 　
ENDSELECT
PRINTL
CS_CAP = CASTLE_CAPACITY(CS_P)
IF CS_CAP > 0
	CS_N = CASTLE_OCCUPANCY(CS_P)
	PRINTFORML 安置人数：{CS_N}/{CS_CAP}　设施等级：{CASTLE_LEVEL:CS_P}
	SIF CS_N > CS_CAP
		PRINTL ※容量不足，现有人员保留，请扩建或迁居。
ENDIF
PRINTL 【当前在场】
CS_N = 0
FOR CS_I, 0, CHARANUM
	IF CS_I != MASTER && CASTLE_WHERE(CS_I) == CS_P
		PRINTBUTTON NAME:CS_I, 21200 + CS_I
		PRINTFORM  [%CASTLE_ROLE_NAME(CASTLE_PERSON:CS_I:CP_ROLE)%]
		SIF STRLENS(CASTLE_FAMILY_LABEL(CS_I)) > 0
			PRINTFORM  [%CASTLE_FAMILY_LABEL(CS_I)%]
		PRINTL
		CS_N += 1
	ENDIF
NEXT
SIF CS_N == 0
	PRINTL 暂无在场人员。
DRAWLINE
PRINTBUTTON "[199] 休息／结束本时段", 21190
PRINT 　
PRINTBUTTON "[290] 保存", 21090
PRINT 　
PRINTBUTTON "[291] 读取", 21091
PRINT 　
PRINTBUTTON "[292] 设置", 21092
PRINT 　
PRINTBUTTON "[298] 旧版功能入口", 21098
PRINTL
PRINTL 保存和城内巡视不会推进时间；休息、战斗等沿用原游戏结算。
REDRAW 1
RETURN

; 屏幕短编号与内部按钮值共用同一入口，未展示的旧指令不会穿透。
@CASTLE_SHORT_COMMAND(CS_INPUT)
#FUNCTION
#DIM DYNAMIC CS_INPUT
#DIM DYNAMIC CS_PLACE
CS_PLACE = CASTLE_STATE:2
SIF CS_INPUT >= 201 && CS_INPUT <= 207
	RETURNF 20800 + CS_INPUT
SIF CS_INPUT >= 290 && CS_INPUT <= 292
	RETURNF 20800 + CS_INPUT
SIF CS_INPUT == 298
	RETURNF 21098
SIF CS_INPUT == 199
	RETURNF 21190
IF CS_INPUT == 220
	SIF CS_PLACE == CL_THRONE
		RETURNF 21120
	SIF CS_PLACE == CL_FAMILY
		RETURNF 21140
	RETURNF 21100
ELSEIF CS_INPUT == 221
	SELECTCASE CS_PLACE
	CASE CL_THRONE
		RETURNF 21121
	CASE CL_DUNGEON
		RETURNF 21106
	CASE CL_CHAMBER
		RETURNF 21102
	CASE CL_BARRACKS
		RETURNF 21130
	CASE CL_WORKSHOP
		RETURNF 21150
	ENDSELECT
ELSEIF CS_INPUT == 222
	SELECTCASE CS_PLACE
	CASE CL_THRONE
		RETURNF 21122
	CASE CL_CHAMBER
		RETURNF 21103
	CASE CL_BARRACKS
		RETURNF 21131
	CASE CL_WORKSHOP
		RETURNF 21151
	ENDSELECT
ELSEIF CS_INPUT == 223
	SIF CS_PLACE == CL_CHAMBER
		RETURNF 21104
	SIF CS_PLACE == CL_THRONE
		RETURNF 21123
	SIF CS_PLACE == CL_BARRACKS
		RETURNF 21132
ELSEIF CS_INPUT == 224
	SIF CS_PLACE == CL_BARRACKS
		RETURNF 21133
	SIF CS_PLACE == CL_CHAMBER
		RETURNF 21105
ENDIF
SIF CS_INPUT >= 21000 && CS_INPUT <= 21999
	RETURNF CS_INPUT
RETURNF 0

; 返回1结束旧回合；返回2进入旧TRAIN，其余只刷新场所。
@CASTLE_COMMAND(CS_CHOICE)
#DIM DYNAMIC CS_CHOICE
#DIM DYNAMIC CS_P
#DIM DYNAMIC CS_BEFORE_COUNT
CALL CASTLE_SYNC
CS_P = CASTLE_STATE:2
IF CS_CHOICE >= 21001 && CS_CHOICE <= 21007
	SIF CS_CHOICE != 21000 + CL_CHAMBER
		CALL CASTLE_END_VISIT
	CASTLE_STATE:2 = CS_CHOICE - 21000
	CASTLE_STATE:4 = 0
	RETURN 0
ELSEIF CS_CHOICE >= 21200 && CS_CHOICE < 21200 + CHARANUM
	IF CASTLE_WHERE(CS_CHOICE - 21200) == CS_P
		CALL CASTLE_PERSON_MENU(CS_CHOICE - 21200)
	ENDIF
	RETURN 0
ENDIF
SELECTCASE CS_CHOICE
CASE 21090
	CALL SYSTEM_SAVEGAME
CASE 21091
	CALL SYSTEM_LOADGAME
CASE 21092
	CALL CONFIG
CASE 21098
	CASTLE_STATE:4 = 1
CASE 21099
	CASTLE_STATE:4 = 0
CASE 21100
	CALL CASTLE_ROSTER(0)
CASE 21120
	SIF CS_P != CL_THRONE
		RETURN 0
	CALL CASTLE_ROSTER(1)
CASE 21121
	SIF CS_P != CL_THRONE
		RETURN 0
	CALL CASTLE_BUILD
CASE 21122
	SIF CS_P != CL_THRONE
		RETURN 0
	CALL INVASION
	SIF RESULT == 1
		RETURN 1
CASE 21123
	SIF CS_P != CL_THRONE
		RETURN 0
	BOUGHT = 1
CASE 21106
	SIF CS_P != CL_DUNGEON
		RETURN 0
	PRINTL 在人员详情中选择“带往寝宫”。
	CALL CASTLE_ROSTER(0)
CASE 21105
	SIF CS_P != CL_CHAMBER
		RETURN 0
	CALL CASTLE_END_VISIT
	PRINTL 临时来访者已返回原先的居所或岗位。
CASE 21102, 21103
	SIF CS_P != CL_CHAMBER
		RETURN 0
	IF CS_CHOICE == 21102 || TARGET < 1
		CALL SELECT_TARGET
	ENDIF
	SIF CS_CHOICE == 21102
		RETURN 0
	IF TARGET < 1 || TARGET >= CHARANUM
		RETURN 0
	ENDIF
	IF IS_TRAINABLE(TARGET) != 0
		PRINTW 对象不在此处，或其身份、年龄及亲属关系不允许这项互动。
		RETURN 0
	ENDIF
	ASSI = -1
	FLAG:2 = -1
	RETURN 2
CASE 21104
	SIF CS_P != CL_CHAMBER
		RETURN 0
	IF TARGET < 1 || TARGET >= CHARANUM
		CALL SELECT_TARGET
	ENDIF
	SIF TARGET < 1 || TARGET >= CHARANUM
		RETURN 0
	IF IS_TRAINABLE(TARGET) != 0 || IS_ABLE_TO_ABILITY_UP(TARGET) == 0
		PRINTW 请先选择在场且能够培养能力的成年对象。
		RETURN 0
	ENDIF
	CALL ABILITY_UP_CORE(TARGET)
CASE 21130
	SIF CS_P != CL_BARRACKS
		RETURN 0
	CALL CASTLE_TROOPS
CASE 21131
	SIF CS_P != CL_BARRACKS
		RETURN 0
	IF CASTLE_TROOP_TOTAL() >= CASTLE_TROOP_CAPACITY()
		PRINTW 兵营编制已满，请先扩建兵营。
		RETURN 0
	ENDIF
	IF MONEY < 500
		PRINTW 召唤仪式需要500资金。
		RETURN 0
	ENDIF
	CALL CASTLE_SPEND
	SIF RESULT == 0
		RETURN 0
	MONEY -= 500
	EX_FLAG:4444 -= 500
	CALL SUMMON_MONSTER(0)
CASE 21132
	SIF CS_P != CL_BARRACKS
		RETURN 0
	CALL DUNGEON_INFO2
CASE 21133
	SIF CS_P != CL_BARRACKS
		RETURN 0
	CS_BEFORE_COUNT = CHARANUM
	CALL MONSTER_SHOP
	FOR CS_CHOICE, CS_BEFORE_COUNT, CHARANUM
		CALL CASTLE_ACCEPT(CS_CHOICE, 1)
		SIF RESULT
			CALL CHARACTER_EVENT(CS_CHOICE, CE_JOIN)
	NEXT
CASE 21140
	SIF CS_P != CL_FAMILY
		RETURN 0
	CALL CASTLE_ROSTER(2)
CASE 21150
	SIF CS_P != CL_WORKSHOP
		RETURN 0
	CALL LABO
CASE 21151
	SIF CS_P != CL_WORKSHOP
		RETURN 0
	CALL TAILOR_MAIN
CASE 21190
	PRINTL 魔王暂歇片刻，各部门继续运转。
	CALL CHARACTER_LOCAL_REST
	RETURN 1
ENDSELECT
RETURN 0

@CASTLE_ROSTER(CS_MODE)
#DIM DYNAMIC CS_MODE
#DIM DYNAMIC CS_I
#DIM DYNAMIC CS_PICK
#DIM DYNAMIC CS_ORIGINAL_PLACE
CS_ORIGINAL_PLACE = CASTLE_STATE:2
$ROSTER
CALL CASTLE_SYNC
DRAWLINE
PRINTL 【人员名册】姓名旁的编号是永久身份，不随列表排序或改名变化。
FOR CS_I, 0, CHARANUM
	SIF CS_I == MASTER
		CONTINUE
	SIF CS_MODE == 0 && CASTLE_WHERE(CS_I) != CASTLE_STATE:2
		CONTINUE
	SIF CS_MODE == 2 && CASTLE_PERSON:CS_I:CP_ROLE != CR_FAMILY
		CONTINUE
	PRINTFORM [{CS_I}] %NAME:CS_I%　ID:{CASTLE_PERSON:CS_I:CP_UID}　%CASTLE_ROLE_NAME(CASTLE_PERSON:CS_I:CP_ROLE)%
	PRINTFORM 　%CASTLE_FAMILY_LABEL(CS_I)%　%CASTLE_PLACE_NAME(CASTLE_WHERE(CS_I))%
	PRINTL
NEXT
PRINTL [999] 返回
INPUT
CS_PICK = RESULT
SIF CS_PICK == 999
	RETURN
SIF CS_PICK < 0 || CS_PICK >= CHARANUM || CS_PICK == MASTER
	GOTO ROSTER
SIF CS_MODE == 0 && CASTLE_WHERE(CS_PICK) != CASTLE_STATE:2
	GOTO ROSTER
SIF CS_MODE == 2 && CASTLE_PERSON:CS_PICK:CP_ROLE != CR_FAMILY
	GOTO ROSTER
CALL CASTLE_PERSON_MENU(CS_PICK)
SIF CASTLE_STATE:2 != CS_ORIGINAL_PLACE
	RETURN
GOTO ROSTER

@CASTLE_PERSON_MENU(CS_P)
#DIM DYNAMIC CS_P
#DIM DYNAMIC CS_PICK
#DIM DYNAMIC CS_AT
#DIM DYNAMIC CS_TALK_STAMP
#DIM DYNAMIC CS_SOURCE
$CS_PERSON
CALL CASTLE_SYNC
SIF CS_P < 0 || CS_P >= CHARANUM || CS_P == MASTER
	RETURN
CS_AT = CASTLE_WHERE(CS_P)
CALL CASTLE_SCREEN_HEADER(@"%NAME:CS_P%", @"人物档案　编号：{CASTLE_PERSON:CS_P:CP_UID}")
PRINTFORML 身份：%CASTLE_ROLE_NAME(CASTLE_PERSON:CS_P:CP_ROLE)%　%CASTLE_FAMILY_LABEL(CS_P)%
PRINTFORML 人类换算年龄：{CFLAG:CS_P:451}　等级：{CFLAG:CS_P:9}
PRINTFORML 居所：%CASTLE_PLACE_NAME(CASTLE_PERSON:CS_P:CP_HOME)%
PRINTFORM 职责：
IF CASTLE_PERSON:CS_P:CP_WORK > 0
	PRINTFORML %CASTLE_PLACE_NAME(CASTLE_PERSON:CS_P:CP_WORK)%工作人员
ELSE
	PRINTL 未任命
ENDIF
PRINTFORML 当前所在：%CASTLE_PLACE_NAME(CS_AT)%
CALL FAMILY_PRINT_INFO(CS_P)
IF CASTLE_PERSON:CS_P:CP_ROLE == CR_CAPTIVE
	CALL CASTLE_SHOW_SUBMISSION(CS_P)
	IF CS_AT == CL_DUNGEON && CASTLE_STATE:2 == CL_DUNGEON
		PRINTL [1] 交谈与归顺交涉（展开话题与选项）
	ELSE
		PRINTL [1] 日常交谈（展开话题与选项）
	ENDIF
	PRINTL [2] 确认归顺（任一路线达标，1行动）
ELSE
	PRINTL [1] 交谈／陪伴（展开话题；正式交谈消耗1行动）
ENDIF
IF CASTLE_PERSON:CS_P:CP_ROLE == CR_FOLLOWER || CASTLE_PERSON:CS_P:CP_ROLE == CR_FAMILY
	PRINTL [3] 安排居所（1行动）　[4] 任命／解除职责（1行动）
ENDIF
SIF CASTLE_BRING_REASON(CS_P) == 0 && CASTLE_STATE:2 != CL_CHAMBER
	PRINTL [6] 带往寝宫（移动不消耗城务行动）
PRINTL [999] 返回
INPUT
CS_PICK = RESULT
SIF CS_PICK == 999
	RETURN
IF CS_PICK == 6
	CALL CASTLE_BRING(CS_P)
	SIF RESULT == 1
		RETURN
ELSEIF CS_PICK == 1
	IF CS_AT == 0 || CS_AT != CASTLE_STATE:2
		PRINTW 需要先前往对方所在的设施。
		GOTO CS_PERSON
	ENDIF
	IF DIALOGUE_CHAT_ELIGIBLE(CS_P)
		CALL DIALOGUE_MAIN(CS_P)
		GOTO CS_PERSON
	ENDIF
	CS_TALK_STAMP = DAY * 2 + TIME + 1
	IF CASTLE_PERSON:CS_P:CP_LASTTALK == CS_TALK_STAMP
		PRINTW 你们本时段已经交流过了。
		GOTO CS_PERSON
	ENDIF
	CALL CASTLE_SPEND
	SIF RESULT == 0
		GOTO CS_PERSON
	CASTLE_PERSON:CS_P:CP_LASTTALK = CS_TALK_STAMP
	IF CASTLE_PERSON:CS_P:CP_ROLE == CR_FAMILY
		PRINTFORML 你陪伴了%NAME:CS_P%，听对方说起今天的生活。
	ELSE
		PRINTFORML %NAME:CS_P%向你谈起近况，彼此增进了了解。
	ENDIF
ELSEIF CS_PICK == 2 && CASTLE_PERSON:CS_P:CP_ROLE == CR_CAPTIVE
	IF CS_AT != CASTLE_STATE:2 || CS_AT != CL_DUNGEON
		PRINTW 需要前往地牢确认归顺。
		GOTO CS_PERSON
	ENDIF
	IF CASTLE_SUBMISSION_REASON(CS_P) != 0 && CASTLE_PERSUADE_REASON(CS_P) != 0
		PRINTW 两条归顺路线均未达标，请继续调教培养或魅力游说。
		GOTO CS_PERSON
	ENDIF
	IF CASTLE_RESIDENTS(CL_QUARTERS) >= CASTLE_CAPACITY(CL_QUARTERS)
		PRINTW 部下居所已满，请先扩建或调整安置。
		GOTO CS_PERSON
	ENDIF
	CALL CASTLE_SPEND
	SIF RESULT == 0
		GOTO CS_PERSON
	CS_SOURCE = CASTLE_SUBMISSION_REASON(CS_P) == 0 ? 2 # 3
	CALL CASTLE_ACCEPT(CS_P, CS_SOURCE)
	PRINTFORML %NAME:CS_P%正式归顺，成为部下并迁入部下居所。
	CALL CHARACTER_EVENT(CS_P, CE_JOIN)
ELSEIF CS_PICK == 3 || CS_PICK == 4
	SIF CASTLE_PERSON:CS_P:CP_ROLE != CR_FOLLOWER && CASTLE_PERSON:CS_P:CP_ROLE != CR_FAMILY
		GOTO CS_PERSON
	IF CS_AT == 0 || (CASTLE_STATE:2 != CL_THRONE && CS_AT != CASTLE_STATE:2)
		PRINTW 需要在王座厅安排人事，或前往对方所在设施。
		GOTO CS_PERSON
	ENDIF
	CALL CASTLE_ASSIGN(CS_P, CS_PICK)
ENDIF
GOTO CS_PERSON

@CASTLE_ASSIGN(CS_P, CS_MODE)
#DIM DYNAMIC CS_P
#DIM DYNAMIC CS_MODE
#DIM DYNAMIC CS_I
#DIM DYNAMIC CS_DEST
#DIM DYNAMIC CS_EXTRA
DRAWLINE
IF CS_MODE == 3
	PRINTL 请选择居所：[3] 部下居所　[4] 魔王寝宫　[6] 家族居所
ELSE
	PRINTL 请选择职责：[0] 解除职责　[1] 城务　[2] 看守　[3] 内务
	PRINTL [5] 兵营教官　[6] 家族照顾　[7] 工坊研究
ENDIF
PRINTL [999] 取消
INPUT
CS_DEST = RESULT
SIF CS_DEST == 999
	RETURN
IF CS_MODE == 3
	SIF CS_DEST != CL_QUARTERS && CS_DEST != CL_CHAMBER && CS_DEST != CL_FAMILY
		RETURN
	SIF CS_DEST == CASTLE_PERSON:CS_P:CP_HOME
		RETURN
	IF CS_DEST == CL_CHAMBER && (CFLAG:CS_P:451 < 18 || CASTLE_PERSON:CS_P:CP_ROLE != CR_FOLLOWER || CASTLE_PRIVATE_REASON(MASTER, CS_P))
		PRINTW 寝宫仅能邀请无亲属关系的成年归顺者迁入。
		RETURN
	ENDIF
	IF CFLAG:CS_P:451 < 18 && CS_DEST != CL_FAMILY
		PRINTW 尚未成年的成员应在家族居所接受照顾。
		RETURN
	ENDIF
	CS_EXTRA = 1
	SIF CS_DEST == CL_CHAMBER && CASTLE_STATE:6 == CASTLE_PERSON:CS_P:CP_UID
		CS_EXTRA = 0
	IF CASTLE_OCCUPANCY(CS_DEST) + CS_EXTRA > CASTLE_CAPACITY(CS_DEST)
		PRINTW 该设施已满，请先扩建。
		RETURN
	ENDIF
ELSE
	SIF CS_DEST < 0 || CS_DEST > 7 || CS_DEST == CL_CHAMBER
		RETURN
	SIF CS_DEST == CASTLE_PERSON:CS_P:CP_WORK
		RETURN
	IF CFLAG:CS_P:451 < 18 && CS_DEST != 0
		PRINTW 尚未成年的成员不参与城务任职。
		RETURN
	ENDIF
ENDIF
CALL CASTLE_SPEND
SIF RESULT == 0
	RETURN
IF CS_MODE == 3
	CASTLE_PERSON:CS_P:CP_HOME = CS_DEST
	PRINTFORML %NAME:CS_P%的居所改为%CASTLE_PLACE_NAME(CS_DEST)%；职责保持不变。
	CALL CHARACTER_EVENT(CS_P, CE_HOME)
ELSE
	CASTLE_PERSON:CS_P:CP_WORK = CS_DEST
	PRINTL 任命已更新。上午前往工作地点，下午返回居所；外出和伤病状态优先。
	CALL CHARACTER_EVENT(CS_P, CS_DEST == 0 ? CE_JOB_CLEAR # CE_JOB)
ENDIF
RETURN

@CASTLE_BUILD
#DIM DYNAMIC CS_I
#DIM DYNAMIC CS_DEST
#DIM DYNAMIC CS_PRICE
DRAWLINE
PRINTL 【设施扩建】每次消耗1行动，费用为当前等级乘1000。
FOR CS_I, 1, 8
	SIF CS_I == CL_THRONE || CS_I == CL_WORKSHOP
		CONTINUE
	PRINTFORML [{CS_I}] %CASTLE_PLACE_NAME(CS_I)%　等级{CASTLE_LEVEL:CS_I}　费用{CASTLE_LEVEL:CS_I * 1000}
NEXT
PRINTL [999] 返回
INPUT
CS_DEST = RESULT
SIF CS_DEST < 1 || CS_DEST > 7
	RETURN
SIF CS_DEST == CL_THRONE || CS_DEST == CL_WORKSHOP
	RETURN
IF CASTLE_LEVEL:CS_DEST >= 10
	PRINTW 该设施已达到10级。
	RETURN
ENDIF
CS_PRICE = CASTLE_LEVEL:CS_DEST * 1000
IF MONEY < CS_PRICE
	PRINTW 资金不足。
	RETURN
ENDIF
CALL CASTLE_SPEND
SIF RESULT == 0
	RETURN
MONEY -= CS_PRICE
EX_FLAG:4444 -= CS_PRICE
CASTLE_LEVEL:CS_DEST += 1
PRINTFORML %CASTLE_PLACE_NAME(CS_DEST)%扩建完成，现为{CASTLE_LEVEL:CS_DEST}级。
RETURN

@CASTLE_TROOP_TOTAL()
#FUNCTION
#DIM DYNAMIC CS_I
#DIM DYNAMIC CS_TOTAL
FOR CS_I, 100, 200
	CS_TOTAL += MAX(0, ITEM:CS_I)
NEXT
RETURNF CS_TOTAL

@CASTLE_TROOP_CAPACITY()
#FUNCTION
RETURNF 100 + CASTLE_LEVEL:CL_BARRACKS * 100

@CASTLE_TROOPS
#DIM DYNAMIC CS_I
#DIM DYNAMIC CS_PICK
#DIM DYNAMIC CS_NUM
#DIM DYNAMIC CS_TOTAL
#DIM DYNAMIC CS_GUARDS
#DIM DYNAMIC CS_CAP
$TROOPS
CALL CASTLE_SYNC
CS_TOTAL = 0
CS_GUARDS = 0
DRAWLINE
PRINTL 【部队与地牢驻防】驻防兵是总兵力中的一部分，不重复计数。
FOR CS_I, 100, 200
	SIF ITEM:CS_I <= 0
		CONTINUE
	PRINTFORML [{CS_I}] %ITEMNAME:CS_I%　总数{ITEM:CS_I}　兵营待命{ITEM:CS_I-CASTLE_GUARD:CS_I}　地牢驻防{CASTLE_GUARD:CS_I}
	CS_TOTAL += ITEM:CS_I
	CS_GUARDS += CASTLE_GUARD:CS_I
NEXT
CS_CAP = 100 + CASTLE_LEVEL:CL_BARRACKS * 100
PRINTFORML 总兵力{CS_TOTAL}　待命{CS_TOTAL-CS_GUARDS}　驻防{CS_GUARDS}　召唤编制{CS_CAP}
SIF CS_TOTAL > CS_CAP
	PRINTL 现有旧版兵力超出召唤编制，部队保留；扩建后可继续召唤。
PRINTL 输入兵种编号调整地牢驻防（1行动）；[999] 返回
INPUT
CS_PICK = RESULT
SIF CS_PICK == 999
	RETURN
SIF CS_PICK < 100 || CS_PICK >= 200
	GOTO TROOPS
SIF ITEM:CS_PICK <= 0
	GOTO TROOPS
PRINTFORML 地牢配置多少%ITEMNAME:CS_PICK%？输入0至{ITEM:CS_PICK}，当前{CASTLE_GUARD:CS_PICK}；-1取消。
INPUT
CS_NUM = RESULT
SIF CS_NUM < 0 || CS_NUM > ITEM:CS_PICK || CS_NUM == CASTLE_GUARD:CS_PICK
	GOTO TROOPS
CALL CASTLE_SPEND
SIF RESULT == 0
	GOTO TROOPS
CASTLE_GUARD:CS_PICK = CS_NUM
PRINTL 驻防已调整，部队总数不变。原有地下城战斗继续使用统一兵力总账。
GOTO TROOPS
