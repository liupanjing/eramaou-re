; 城内普通事件。显示过程不写状态，完整选择后统一结算。
@IX_REASON(IX_P, IX_E)
#FUNCTION
#DIM DYNAMIC IX_P
#DIM DYNAMIC IX_E
#DIM DYNAMIC IX_PRE
SIF IX_E < 1 || IX_E > 15
	RETURNF 1
SIF IX_RULE(IX_E, 0) < 0
	RETURNF 1
SIF IX_P < 0 || IX_P >= CHARANUM || IX_P == MASTER
	RETURNF 2
SIF CASTLE_PRIVATE_REASON(MASTER, IX_P) || CASTLE_HAS_FAMILY(IX_P)
	RETURNF 2
SIF DIALOGUE_PROFILE(IX_P) == 165 || DIALOGUE_PROFILE(IX_P) == 104
	RETURNF 2
SIF CASTLE_ROLE(IX_P) != CR_FOLLOWER || CFLAG:IX_P:1 != 0
	RETURNF 2
SIF CASTLE_WHERE(IX_P) == 0 || CASTLE_WHERE(IX_P) != CASTLE_STATE:2 || IX_MATCH(IX_P, IX_E) == 0
	RETURNF 3
SIF DIALOGUE_PERSON:IX_P:DP_TRUST < IX_RULE(IX_E, 2)
	RETURNF 4
IX_PRE = IX_RULE(IX_E, 3)
IF IX_PRE > 0
	SIF INTERACTION_COUNT:IX_P:IX_PRE == 0
		RETURNF 4
	SIF IX_RULE(IX_E, 4) > 0 && INTERACTION_CHOICE:IX_P:IX_PRE != IX_RULE(IX_E, 4)
		RETURNF 4
ENDIF
SIF IX_RULE(IX_E, 1) == 0 && INTERACTION_COUNT:IX_P:IX_E > 0
	RETURNF 5
SIF IX_RULE(IX_E, 0) == 0
	RETURNF 10
SIF DIALOGUE_PERSON:IX_P:DP_LAST == DAY * 2 + TIME + 1 || INTERACTION_LAST:IX_P:IX_E == DAY * 2 + TIME + 1
	RETURNF 6
SIF CASTLE_STATE:5 < IX_RULE(IX_E, 5) || MONEY < IX_RULE(IX_E, 6)
	RETURNF 7
RETURNF 0

@IX_FEEDBACK(IX_REASON_CODE)
#DIM DYNAMIC IX_REASON_CODE
SELECTCASE IX_REASON_CODE
CASE 2, 3
	PRINTW 请前往对方所在的设施；当前事件面向在城的成年部下。
CASE 4
	PRINTW 还没有满足这段事件的前置条件。
CASE 5
	PRINTW 这段事件已经完成，可以在相处记录中回顾选择。
CASE 6
	PRINTW 本时段已经与对方认真交谈过，下个时段再来吧。
CASE 7
	PRINTW 行动或资金不足，尚未开始这段事件。
CASE 10
	PRINTW 这段事件的正文尚未补齐。本次不消耗行动或资金，也不推进关系与记录。
CASEELSE
	PRINTW 当前没有这段事件。
ENDSELECT
RETURN 0

@IX_PROSE(IX_P, IX_E, IX_KEY)
#DIM DYNAMIC IX_P
#DIM DYNAMIC IX_E
#DIM DYNAMIC IX_KEY
#DIM DYNAMIC IX_LINE
#DIMS DYNAMIC IX_SENTENCE
FOR IX_LINE, 0, 12
	IX_SENTENCE '= IX_TEXT(IX_P, IX_E, IX_KEY, IX_LINE)
	SIF STRLENS(IX_SENTENCE) == 0
		BREAK
	CALL DIALOGUE_PROSE(IX_P, IX_SENTENCE)
NEXT
RETURN

@IX_PLAY(IX_P, IX_E)
#DIM DYNAMIC IX_P
#DIM DYNAMIC IX_E
#DIM DYNAMIC IX_R
#DIM DYNAMIC IX_C
#DIM DYNAMIC IX_PICK
#DIM DYNAMIC IX_FIRST
#DIM DYNAMIC IX_SECOND
#DIM DYNAMIC IX_CHECK
IX_CHECK = IX_REASON(IX_P, IX_E)
IF IX_CHECK
	CALL IX_FEEDBACK(IX_CHECK)
	RETURN 0
ENDIF
CALL DIALOGUE_SCENE_HEADER(IX_P, IX_TITLE(IX_E))
PRINTFORML 完整交谈消耗{IX_RULE(IX_E, 5)}行动、{IX_RULE(IX_E, 6)}资金。选完后结算，中途返回不消耗。
IF INTERACTION_COUNT:IX_P:IX_E > 0
	PRINTL 你们曾经聊过这个话题；本次重谈不重复增加关系数值。
	CALL IX_PROSE(IX_P, IX_E, 2)
ELSE
	CALL IX_PROSE(IX_P, IX_E, 1)
ENDIF
FOR IX_R, 1, 3
	CALL IX_PROSE(IX_P, IX_E, IX_R * 100)
	FOR IX_C, 1, IX_CHOICES(IX_E, IX_R) + 1
		CALL DIALOGUE_OPTION(IX_C, DIALOGUE_FORMAT(IX_P, IX_TEXT(IX_P, IX_E, IX_R * 100 + IX_C * 10 + 1, 0)))
	NEXT
	CALL DIALOGUE_OPTION(0, "暂时结束交谈")
	$IX_PICK
	INPUT
	IX_PICK = RESULT
	SIF IX_PICK == 0 || IX_PICK == 999
		RETURN 0
	SIF IX_PICK < 1 || IX_PICK > IX_CHOICES(IX_E, IX_R)
		GOTO IX_PICK
	IF IX_R == 1
		IX_FIRST = IX_PICK
	ELSE
		IX_SECOND = IX_PICK
	ENDIF
	CALL IX_PROSE(IX_P, IX_E, IX_R * 100 + IX_PICK * 10 + 2)
NEXT
CALL IX_COMMIT(IX_P, IX_E, IX_FIRST, IX_SECOND)
SIF RESULT == 0
	RETURN 0
CALL IX_PROSE(IX_P, IX_E, 3)
RETURN 1

; 最终结算再验证对象、资源和选项。取消和非法直调不能留下半次事件。
@IX_COMMIT(IX_P, IX_E, IX_FIRST, IX_SECOND)
#DIM DYNAMIC IX_P
#DIM DYNAMIC IX_E
#DIM DYNAMIC IX_FIRST
#DIM DYNAMIC IX_SECOND
#DIM DYNAMIC IX_CHECK
#DIM DYNAMIC IX_TRUST
#DIM DYNAMIC IX_AFF
#DIMS DYNAMIC IX_SIGN
IX_CHECK = IX_REASON(IX_P, IX_E)
IF IX_CHECK
	CALL IX_FEEDBACK(IX_CHECK)
	RETURN 0
ENDIF
SIF IX_FIRST < 1 || IX_FIRST > IX_CHOICES(IX_E, 1) || IX_SECOND < 1 || IX_SECOND > IX_CHOICES(IX_E, 2)
	RETURN 0
IF INTERACTION_COUNT:IX_P:IX_E == 0
	IX_TRUST = IX_EFFECT(IX_E, 1, IX_FIRST, 0) + IX_EFFECT(IX_E, 2, IX_SECOND, 0)
	IX_AFF = IX_EFFECT(IX_E, 1, IX_FIRST, 1) + IX_EFFECT(IX_E, 2, IX_SECOND, 1)
ENDIF
IX_TRUST = LIMIT(DIALOGUE_PERSON:IX_P:DP_TRUST + IX_TRUST, 0, 100) - DIALOGUE_PERSON:IX_P:DP_TRUST
; 原作部分个人剧情允许好感超过100％，此处只设下限，不截断旧值。
IX_AFF = MAX(0, CFLAG:IX_P:2 + IX_AFF) - CFLAG:IX_P:2
CASTLE_STATE:5 -= IX_RULE(IX_E, 5)
MONEY -= IX_RULE(IX_E, 6)
EX_FLAG:4444 -= IX_RULE(IX_E, 6)
DIALOGUE_PERSON:IX_P:DP_TRUST += IX_TRUST
CFLAG:IX_P:2 += IX_AFF
DIALOGUE_PERSON:IX_P:DP_LAST = DAY * 2 + TIME + 1
DIALOGUE_PERSON:IX_P:DP_MET = 1
INTERACTION_COUNT:IX_P:IX_E = MIN(999, INTERACTION_COUNT:IX_P:IX_E + 1)
INTERACTION_CHOICE:IX_P:IX_E = IX_FIRST * 10 + IX_SECOND
INTERACTION_LAST:IX_P:IX_E = DAY * 2 + TIME + 1
IX_SIGN '= IX_AFF < 0 ? "-" # "+"
PRINTFORML 信任变化：{IX_TRUST}　好感变化：%IX_SIGN%{ABS(IX_AFF) / 10}.{ABS(IX_AFF) % 10}％
RETURN 1

@IX_MENU(IX_P)
#DIM DYNAMIC IX_P
#DIM DYNAMIC IX_E
#DIM DYNAMIC IX_CHECK
#DIM DYNAMIC IX_PICK
#DIM DYNAMIC IX_VISIBLE
#DIMS DYNAMIC IX_LABEL
SIF IX_P < 0 || IX_P >= CHARANUM || IX_P == MASTER
	RETURN 0
$IX_MENU
CALL DIALOGUE_SCENE_HEADER(IX_P, "城内相处")
PRINTFORML 信任：{DIALOGUE_PERSON:IX_P:DP_TRUST}／100　好感：{CFLAG:IX_P:2 / 10}％
IX_VISIBLE = 0
FOR IX_E, 1, 16
	SIF IX_RULE(IX_E, 0) < 0
		CONTINUE
	IX_CHECK = IX_REASON(IX_P, IX_E)
	SIF IX_CHECK == 2 || IX_CHECK == 3 || IX_CHECK == 4 || IX_CHECK == 5
		CONTINUE
	IX_LABEL '= IX_TITLE(IX_E)
	SELECTCASE IX_CHECK
	CASE 6
		IX_LABEL += "（下个时段可谈）"
	CASE 7
		IX_LABEL += "（行动或资金不足）"
	CASE 10
		IX_LABEL += "（待补正文）"
	ENDSELECT
	CALL DIALOGUE_OPTION(IX_E, IX_LABEL)
	IX_VISIBLE += 1
NEXT
SIF IX_VISIBLE == 0
	PRINTL 现在没有适合展开的话题，可以先查看以前的相处记录。
CALL DIALOGUE_OPTION(90, "查看相处记录")
CALL DIALOGUE_OPTION(0, "返回人物档案")
INPUT
IX_PICK = RESULT
SIF IX_PICK == 0 || IX_PICK == 999
	RETURN 0
IF IX_PICK == 90
	CALL IX_HISTORY(IX_P)
ELSEIF IX_PICK >= 1 && IX_PICK <= 15
	CALL IX_PLAY(IX_P, IX_PICK)
ENDIF
GOTO IX_MENU

@IX_HISTORY(IX_P)
#DIM DYNAMIC IX_P
#DIM DYNAMIC IX_E
#DIM DYNAMIC IX_R
#DIM DYNAMIC IX_C
SIF IX_P < 0 || IX_P >= CHARANUM
	RETURN 0
CALL DIALOGUE_SCENE_HEADER(IX_P, "相处记录")
FOR IX_E, 1, 16
	SIF INTERACTION_COUNT:IX_P:IX_E == 0
		CONTINUE
	PRINTFORML %IX_TITLE(IX_E)%　完成{INTERACTION_COUNT:IX_P:IX_E}次　最近：第{(INTERACTION_LAST:IX_P:IX_E - 1) / 2 + 1}日
	FOR IX_R, 1, 3
		IX_C = IX_R == 1 ? INTERACTION_CHOICE:IX_P:IX_E / 10 # INTERACTION_CHOICE:IX_P:IX_E % 10
		PRINTFORML %DIALOGUE_FORMAT(IX_P, IX_TEXT(IX_P, IX_E, IX_R * 100 + IX_C * 10 + 1, 0))%
	NEXT
NEXT
PRINTW 记录保留每段事件的完成次数与最近选择。
RETURN 1

; 兼容旧离城字符串，在CP1字段末追加独立IX1字段。
@IX_EXPORT(IX_P)
#FUNCTIONS
#DIM DYNAMIC IX_P
#DIM DYNAMIC IX_GROUP
#DIM DYNAMIC IX_E
#DIMS DYNAMIC IX_MEMORY
IX_MEMORY = _IX1
FOR IX_GROUP, 0, 3
	IX_MEMORY += "_"
	FOR IX_E, 0, 16
		SIF IX_E > 0
			IX_MEMORY += ","
		SELECTCASE IX_GROUP
		CASE 0
			IX_MEMORY += TOSTR(INTERACTION_COUNT:IX_P:IX_E)
		CASE 1
			IX_MEMORY += TOSTR(INTERACTION_CHOICE:IX_P:IX_E)
		CASE 2
			IX_MEMORY += TOSTR(INTERACTION_LAST:IX_P:IX_E)
		ENDSELECT
	NEXT
NEXT
RETURNF IX_MEMORY

@IX_IMPORT(IX_P, IX_MEMORY)
#DIM DYNAMIC IX_P
#DIMS DYNAMIC IX_MEMORY
#DIMS DYNAMIC IX_FIELDS, 30
#DIMS DYNAMIC IX_VALUES, 16
#DIM DYNAMIC IX_TEMP, 3, 16
#DIM DYNAMIC IX_GROUP
#DIM DYNAMIC IX_E
SIF IX_P < 0 || IX_P >= CHARANUM
	RETURN 0
SPLIT IX_MEMORY, "_", IX_FIELDS
SIF RESULT < 25 || IX_FIELDS:21 != "IX1"
	RETURN 0
FOR IX_GROUP, 0, 3
	SPLIT IX_FIELDS:(22 + IX_GROUP), ",", IX_VALUES
	SIF RESULT != 16
		RETURN 0
	FOR IX_E, 0, 16
		SIF ISNUMERIC(IX_VALUES:IX_E) == 0
			RETURN 0
		IX_TEMP:IX_GROUP:IX_E = TOINT(IX_VALUES:IX_E)
		SIF IX_TEMP:IX_GROUP:IX_E < 0 || (IX_GROUP == 0 && IX_TEMP:IX_GROUP:IX_E > 999) || (IX_GROUP == 1 && IX_TEMP:IX_GROUP:IX_E > 33)
			RETURN 0
	NEXT
NEXT
FOR IX_E, 0, 16
	INTERACTION_COUNT:IX_P:IX_E = IX_TEMP:0:IX_E
	INTERACTION_CHOICE:IX_P:IX_E = IX_TEMP:1:IX_E
	INTERACTION_LAST:IX_P:IX_E = IX_TEMP:2:IX_E
NEXT
RETURN 1
