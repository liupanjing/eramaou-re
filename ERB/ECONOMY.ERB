; 经济v1：出勤快照、每日单次结算、库存与现金分账。菜单不结算。
@EC_INIT
#DIM DYNAMIC EC_I
IF EC_STATE:EC_VERSION == 0
	EC_STATE:EC_VERSION = 1
	EC_STATE:EC_LAST_DAY = DAY - 1
	EC_STATE:EC_SHIFT_DAY = DAY - 1
	EC_STATE:EC_ORDER = 70
	EC_STATE:EC_POLICY = 1
	EC_STATE:EC_MODE = 2
	EC_STATE:EC_RECIPE = 1
	EC_STATE:EC_OPEN_BALANCE = MONEY
	EC_STATE:EC_GRACE_END = DAY + 2
	FOR EC_I, 1, 13
		EC_ACTIVE:EC_I = 1
		SIF EC_I >= 8
			EC_LEVEL:EC_I = 1
	NEXT
	FOR EC_I, 1, 5
		EC_STOCK:EC_I = EC_RESOURCE_VALUE(EC_I, 1)
	NEXT
ENDIF
IF EC_STATE:EC_TRADE_DAY != DAY + 1
	EC_STATE:EC_TRADE_DAY = DAY + 1
	EC_STATE:EC_TRADE_VOLUME = 0
ENDIF
RETURN

@EC_FACILITY_LEVEL(EC_ID)
#FUNCTION
#DIM DYNAMIC EC_ID
SIF EC_ID < 1 || EC_ID > CL_LAST
	RETURNF 0
SIF EC_ID <= 7
	RETURNF LIMIT(CASTLE_LEVEL:EC_ID, 1, 10)
RETURNF LIMIT(EC_LEVEL:EC_ID, 1, 10)

@EC_CAPACITY()
#FUNCTION
RETURNF 150 + EC_FACILITY_LEVEL(CL_STORE) * 150 + EC_TECH:2 * 150

@EC_STOCK_ADD(EC_RESOURCE, EC_AMOUNT)
#DIM DYNAMIC EC_RESOURCE
#DIM DYNAMIC EC_AMOUNT
SIF EC_RESOURCE < 1 || EC_RESOURCE > 4 || EC_AMOUNT <= 0
	RETURN 0
EC_AMOUNT = MIN(EC_AMOUNT, MAX(0, EC_CAPACITY() - EC_STOCK:EC_RESOURCE))
EC_STOCK:EC_RESOURCE += EC_AMOUNT
RETURN EC_AMOUNT

@EC_WORK_REASON(EC_P)
#FUNCTION
#DIM DYNAMIC EC_P
#DIM DYNAMIC EC_JOB
SIF EC_P < 0 || EC_P >= CHARANUM || EC_P == MASTER
	RETURNF 1
SIF CASTLE_ROLE(EC_P) != CR_FOLLOWER && CASTLE_ROLE(EC_P) != CR_FAMILY
	RETURNF 2
SIF CFLAG:EC_P:451 < 18 || CFLAG:EC_P:1 != 0 || BASE:EC_P:0 <= 0
	RETURNF 3
EC_JOB = CASTLE_PERSON:EC_P:CP_WORK
SIF EC_JOB < 1 || EC_JOB > CL_LAST || EC_JOB == CL_CHAMBER
	RETURNF 4
SIF EC_ACTIVE:EC_JOB == 0
	RETURNF 5
RETURNF 0

@EC_WORK_SCORE(EC_P)
#FUNCTION
#DIM DYNAMIC EC_P
RETURNF LIMIT(2 + ABL:EC_P:100 + ABL:EC_P:101 + ABL:EC_P:15 / 2, 2, 12)

@EC_CAPTURE_SHIFT
#DIM DYNAMIC EC_P
#DIM DYNAMIC EC_Q
#DIM DYNAMIC EC_JOB
#DIM DYNAMIC EC_RANK
CALL EC_INIT
SIF TIME != 0 || EC_STATE:EC_SHIFT_DAY == DAY
	RETURN 0
EC_STATE:EC_SHIFT_DAY = DAY
EC_STATE:EC_STAFF = 0
EC_STATE:EC_SHIFT_MODE = EC_STATE:EC_MODE
EC_STATE:EC_SHIFT_PROJECT = EC_STATE:EC_PROJECT
EC_STATE:EC_SHIFT_BUILD = EC_STATE:EC_BUILD_ID
EC_STATE:EC_SHIFT_RECIPE = EC_STATE:EC_RECIPE
FOR EC_JOB, 1, 13
	EC_WORK:EC_JOB = 0
	EC_COUNT:EC_JOB = 0
NEXT
FOR EC_P, 0, CHARANUM
	SIF EC_WORK_REASON(EC_P) != 0
		CONTINUE
	EC_JOB = CASTLE_PERSON:EC_P:CP_WORK
	EC_RANK = 0
	; 固定UID决定超编时的出勤次序，不靠人物列表排序抢名额。
	FOR EC_Q, 0, CHARANUM
		IF EC_WORK_REASON(EC_Q) == 0 && CASTLE_PERSON:EC_Q:CP_WORK == EC_JOB && CASTLE_PERSON:EC_Q:CP_UID < CASTLE_PERSON:EC_P:CP_UID
			EC_RANK += 1
		ENDIF
	NEXT
	SIF EC_RANK >= 1 + EC_FACILITY_LEVEL(EC_JOB)
		CONTINUE
	EC_WORK:EC_JOB += EC_WORK_SCORE(EC_P)
	EC_COUNT:EC_JOB += 1
	EC_STATE:EC_STAFF += 1
NEXT
RETURN 1

@EC_QUOTE(EC_RESOURCE, EC_BUY)
#FUNCTION
#DIM DYNAMIC EC_RESOURCE
#DIM DYNAMIC EC_BUY
#DIM DYNAMIC EC_BASE
SIF EC_RESOURCE < 1 || EC_RESOURCE > 4
	RETURNF 0
EC_BASE = EC_RESOURCE_VALUE(EC_RESOURCE)
SIF EC_BUY
	RETURNF MAX(1, (EC_BASE * (125 - MIN(15, EC_FACILITY_LEVEL(CL_MARKET) * 2)) + 99) / 100)
RETURNF MAX(1, EC_BASE * (65 + MIN(25, EC_FACILITY_LEVEL(CL_MARKET) * 3)) / 100)

@EC_TRADE_LIMIT()
#FUNCTION
RETURNF 50 + EC_FACILITY_LEVEL(CL_MARKET) * 25 + EC_TECH:3 * 50

@EC_TRADE(EC_RESOURCE, EC_AMOUNT)
#DIM DYNAMIC EC_RESOURCE
#DIM DYNAMIC EC_AMOUNT
#DIM DYNAMIC EC_TOTAL
CALL EC_INIT
SIF EC_RESOURCE < 1 || EC_RESOURCE > 4 || EC_AMOUNT == 0 || EC_AMOUNT < -100000 || EC_AMOUNT > 100000
	RETURN 0
IF EC_ACTIVE:CL_MARKET == 0
	PRINTL 市集已停工，请先恢复营业。
	RETURN 0
ENDIF
IF EC_STATE:EC_TRADE_VOLUME + ABS(EC_AMOUNT) > EC_TRADE_LIMIT()
	PRINTL 超过今日市集交易额度。
	RETURN 0
ENDIF
IF EC_AMOUNT > 0
	EC_TOTAL = EC_QUOTE(EC_RESOURCE, 1) * EC_AMOUNT
	IF MONEY < EC_TOTAL || EC_STOCK:EC_RESOURCE + EC_AMOUNT > EC_CAPACITY()
		PRINTL 资金不足或仓库容量不足。
		RETURN 0
	ENDIF
ELSE
	SIF EC_STOCK:EC_RESOURCE < -EC_AMOUNT
		RETURN 0
	EC_TOTAL = EC_QUOTE(EC_RESOURCE, 0) * EC_AMOUNT
ENDIF
CALL CASTLE_SPEND
SIF RESULT == 0
	RETURN 0
MONEY -= EC_TOTAL
EX_FLAG:4444 -= EC_TOTAL
EC_FLOW:0 -= EC_TOTAL
EC_STOCK:EC_RESOURCE += EC_AMOUNT
EC_STATE:EC_TRADE_VOLUME += ABS(EC_AMOUNT)
PRINTFORML 交易完成，现金变动{-EC_TOTAL}；%EC_RESOURCE_NAME(EC_RESOURCE)%现有{EC_STOCK:EC_RESOURCE}。
RETURN 1

@EC_BUILD_START(EC_ID)
#DIM DYNAMIC EC_ID
#DIM DYNAMIC EC_LEVEL_NEXT
#DIM DYNAMIC EC_GOLD
#DIM DYNAMIC EC_MATERIAL
CALL EC_INIT
SIF EC_ID < 1 || EC_ID > CL_LAST || EC_STATE:EC_BUILD_ID != 0 || EC_FACILITY_LEVEL(EC_ID) >= 10
	RETURN 0
EC_LEVEL_NEXT = EC_FACILITY_LEVEL(EC_ID) + 1
EC_GOLD = 400 * EC_LEVEL_NEXT * EC_LEVEL_NEXT
EC_MATERIAL = EC_LEVEL_NEXT * 10
IF MONEY < EC_GOLD || EC_STOCK:2 < EC_MATERIAL
	PRINTL 建设资金或建材不足。
	RETURN 0
ENDIF
CALL CASTLE_SPEND
SIF RESULT == 0
	RETURN 0
MONEY -= EC_GOLD
EX_FLAG:4444 -= EC_GOLD
EC_FLOW:1 -= EC_GOLD
EC_STOCK:2 -= EC_MATERIAL
EC_STATE:EC_BUILD_ID = EC_ID
EC_STATE:EC_BUILD_WORK = 0
EC_STATE:EC_BUILD_NEED = EC_LEVEL_NEXT + 2
PRINTFORML %EC_FACILITY_NAME(EC_ID)%的扩建已开工；完成后生效，费用与建材已支付。
RETURN 1

@EC_PROJECT_START(EC_ID)
#DIM DYNAMIC EC_ID
#DIM DYNAMIC EC_GOLD
CALL EC_INIT
SIF EC_ID < 1 || EC_ID > 3
	RETURN 0
SIF EC_TECH:EC_ID || EC_STATE:EC_PROJECT
	RETURN 0
EC_GOLD = EC_PROJECT_VALUE(EC_ID, 0)
IF MONEY < EC_GOLD || EC_STOCK:2 < EC_PROJECT_VALUE(EC_ID, 1) || EC_STOCK:3 < EC_PROJECT_VALUE(EC_ID, 2)
	PRINTL 研究资金、建材或魔晶不足。
	RETURN 0
ENDIF
CALL CASTLE_SPEND
SIF RESULT == 0
	RETURN 0
MONEY -= EC_GOLD
EX_FLAG:4444 -= EC_GOLD
EC_FLOW:2 -= EC_GOLD
EC_STOCK:2 -= EC_PROJECT_VALUE(EC_ID, 1)
EC_STOCK:3 -= EC_PROJECT_VALUE(EC_ID, 2)
EC_STATE:EC_PROJECT = EC_ID
EC_STATE:EC_RESEARCH_WORK = 0
PRINTFORML 已立项：%EC_PROJECT_NAME(EC_ID)%；研究条件与编号不会因改名或排序改变。
RETURN 1

@EC_RESEARCH_ADVANCE(EC_AMOUNT)
#DIM DYNAMIC EC_AMOUNT
#DIM DYNAMIC EC_ID
EC_ID = EC_STATE:EC_PROJECT
SIF EC_ID < 1 || EC_ID > 3 || EC_AMOUNT <= 0
	RETURN 0
EC_STATE:EC_RESEARCH_WORK += EC_AMOUNT
IF EC_STATE:EC_RESEARCH_WORK >= EC_PROJECT_VALUE(EC_ID, 3)
	EC_TECH:EC_ID = 1
	EC_STATE:EC_PROJECT = 0
	EC_STATE:EC_RESEARCH_WORK = 0
	PRINTFORML 研究完成：%EC_PROJECT_NAME(EC_ID)%——%EC_PROJECT_EFFECT(EC_ID)%
ENDIF
RETURN 1

@EC_RESEARCH_MANUAL
SIF EC_STATE:EC_PROJECT == 0 || EC_STOCK:3 < 2
	RETURN 0
CALL CASTLE_SPEND
SIF RESULT == 0
	RETURN 0
EC_STOCK:3 -= 2
CALL EC_RESEARCH_ADVANCE(5)
RETURN 1

@EC_PRODUCE(EC_RECIPE_ID, EC_WORK_AMOUNT)
#DIM DYNAMIC EC_RECIPE_ID
#DIM DYNAMIC EC_WORK_AMOUNT
#DIM DYNAMIC EC_R
#DIM DYNAMIC EC_OK
#DIM DYNAMIC EC_BATCH
SIF EC_RECIPE_ID < 1 || EC_RECIPE_ID > 3 || EC_WORK_AMOUNT <= 0
	RETURN 0
IF EC_STATE:EC_CRAFT_RECIPE != EC_RECIPE_ID
	EC_STATE:EC_CRAFT_WORK = 0
	EC_STATE:EC_CRAFT_RECIPE = EC_RECIPE_ID
ENDIF
EC_STATE:EC_CRAFT_WORK = MIN(80, EC_STATE:EC_CRAFT_WORK + EC_WORK_AMOUNT)
EC_BATCH = 0
WHILE EC_STATE:EC_CRAFT_WORK >= 8
	EC_OK = 1
	FOR EC_R, 1, 5
		SIF EC_STOCK:EC_R < EC_RECIPE_VALUE(EC_RECIPE_ID, EC_R, 0)
			EC_OK = 0
		SIF EC_RECIPE_VALUE(EC_RECIPE_ID, EC_R, 1) > 0 && EC_STOCK:EC_R - EC_RECIPE_VALUE(EC_RECIPE_ID, EC_R, 0) + EC_RECIPE_VALUE(EC_RECIPE_ID, EC_R, 1) > EC_CAPACITY()
			EC_OK = 0
	NEXT
	SIF EC_OK == 0
		BREAK
	FOR EC_R, 1, 5
		EC_STOCK:EC_R += EC_RECIPE_VALUE(EC_RECIPE_ID, EC_R, 1) - EC_RECIPE_VALUE(EC_RECIPE_ID, EC_R, 0)
	NEXT
	EC_STATE:EC_CRAFT_WORK -= 8
	EC_BATCH += 1
WEND
RETURN EC_BATCH

@EC_SETTLE
#DIM DYNAMIC EC_I
#DIM DYNAMIC EC_P
#DIM DYNAMIC EC_PEOPLE
#DIM DYNAMIC EC_FOOD
#DIM DYNAMIC EC_MISSING
#DIM DYNAMIC EC_INCOME
#DIM DYNAMIC EC_COST
#DIM DYNAMIC EC_PAID
#DIM DYNAMIC EC_REPAID
#DIM DYNAMIC EC_OTHER
#DIM DYNAMIC EC_WORKSHOP
#DIM DYNAMIC EC_RESEARCH
#DIM DYNAMIC EC_EFFECT
#DIM DYNAMIC EC_BOOK
#DIM DYNAMIC EC_SECURITY
#DIM DYNAMIC EC_BEFORE, 5
#DIM DYNAMIC EC_BATCHES
CALL EC_INIT
SIF EC_STATE:EC_LAST_DAY >= DAY
	RETURN 0
; 先登记日期，防止读档、菜单刷新和旧税收入口重复结算；不补发过去天数。
EC_STATE:EC_LAST_DAY = DAY
IF EC_STATE:EC_SHIFT_DAY != DAY
	FOR EC_I, 1, 13
		EC_WORK:EC_I = 0
		EC_COUNT:EC_I = 0
	NEXT
	EC_STATE:EC_STAFF = 0
	EC_STATE:EC_SHIFT_PROJECT = 0
	EC_STATE:EC_SHIFT_BUILD = 0
ENDIF
EC_OTHER = MONEY - EC_STATE:EC_OPEN_BALANCE - EC_FLOW:0 - EC_FLOW:1 - EC_FLOW:2
FOR EC_I, 1, 5
	EC_BEFORE:EC_I = EC_STOCK:EC_I
NEXT
EC_EFFECT = 100
SIF EC_STATE:EC_SHORTAGE > 0 || EC_STATE:EC_DEBT > 0
	EC_EFFECT = 75
IF EC_ACTIVE:CL_FARM
	CALL EC_STOCK_ADD(1, (4 + EC_FACILITY_LEVEL(CL_FARM) * 3 + EC_WORK:CL_FARM * 2) * (100 + 25 * EC_TECH:1) / 100 * EC_EFFECT / 100)
ENDIF
IF EC_ACTIVE:CL_QUARRY
	CALL EC_STOCK_ADD(2, (1 + EC_FACILITY_LEVEL(CL_QUARRY) + EC_WORK:CL_QUARRY) * (100 + 25 * EC_TECH:1) / 100 * EC_EFFECT / 100)
ENDIF
IF EC_ACTIVE:CL_MINE
	CALL EC_STOCK_ADD(3, (1 + EC_FACILITY_LEVEL(CL_MINE) / 2 + EC_WORK:CL_MINE / 2) * (100 + 25 * EC_TECH:1) / 100 * EC_EFFECT / 100)
ENDIF
FOR EC_P, 0, CHARANUM
	SIF CASTLE_WHERE(EC_P) > 0 && CFLAG:EC_P:1 != 11
		EC_PEOPLE += 1
NEXT
EC_FOOD = MAX(1, EC_PEOPLE + MIN(200, (CASTLE_TROOP_TOTAL() + 99) / 100))
EC_FOOD = MAX(1, EC_FOOD * (100 - EC_TECH:2 * 10 - MIN(20, EC_COUNT:CL_STORE * 5)) / 100)
EC_MISSING = MAX(0, EC_FOOD - EC_STOCK:1)
EC_STOCK:1 = MAX(0, EC_STOCK:1 - EC_FOOD)
EC_STATE:EC_SHORTAGE = EC_MISSING
EC_SECURITY = EC_WORK:CL_DUNGEON
FOR EC_I, 100, 200
	EC_SECURITY += CASTLE_GUARD:EC_I / 50
NEXT
EC_STATE:EC_ORDER += (EC_STATE:EC_POLICY == 0 ? 2 # (EC_STATE:EC_POLICY == 2 ? -3 # 0)) + MIN(3, EC_SECURITY / 3) + MIN(2, EC_COUNT:CL_QUARTERS)
SIF EC_MISSING > 0
	EC_STATE:EC_ORDER -= MIN(8, EC_MISSING)
SIF EC_STATE:EC_DEBT > 0
	EC_STATE:EC_ORDER -= 1
EC_STATE:EC_ORDER = LIMIT(EC_STATE:EC_ORDER, 0, 100)
EC_INCOME = 200 + EC_FACILITY_LEVEL(CL_THRONE) * 100 + MIN(300, MAX(0, CFLAG:MASTER:9) * 4) + MIN(300, EC_WORK:CL_THRONE * 15) + MIN(300, EC_WORK:CL_MARKET * 12)
EC_INCOME += (FLAG:82 ? 200 # MIN(200, MAX(0, FLAG:81) / 20))
EC_INCOME += (FLAG:87 == 2 ? 200 # MIN(200, MAX(0, FLAG:86) / 20))
EC_INCOME += (FLAG:89 == 2 ? 200 # MIN(200, MAX(0, FLAG:88) / 20))
EC_INCOME += (FLAG:91 == 2 ? 200 # MIN(200, MAX(0, FLAG:90) / 20))
EC_INCOME = EC_INCOME * (75 + LIMIT(EX_FLAG:99, 0, 100) / 4) / 100 * (50 + EC_STATE:EC_ORDER / 2) / 100
EC_INCOME = EC_INCOME * (EC_STATE:EC_POLICY == 0 ? 80 # (EC_STATE:EC_POLICY == 2 ? 125 # 100)) / 100
; 原内政休息加成只消费一次，上限20%，不积累到下一次旧十日税。
EC_INCOME = EC_INCOME * (100 + LIMIT(FLAG:9, 0, 20)) / 100
FLAG:9 = 0
FOR EC_I, 1, 13
	EC_COST += EC_UPKEEP(EC_I) * EC_FACILITY_LEVEL(EC_I) * (EC_ACTIVE:EC_I ? 100 # 50) / 100
NEXT
SIF EC_ACTIVE:CL_BARRACKS
	EC_STATE:EC_DRILL = MIN(100, EC_STATE:EC_DRILL + MIN(10, EC_WORK:CL_BARRACKS))
EC_COST += MIN(3000, (CASTLE_TROOP_TOTAL() + 99) / 100 * 8) * (100 - EC_STATE:EC_DRILL / 5) / 100
EC_COST += EC_STATE:EC_STAFF * 12
SIF DAY <= EC_STATE:EC_GRACE_END
	EC_COST = 0
MONEY += EC_INCOME
EX_FLAG:4444 += EC_INCOME
EC_PAID = MIN(MAX(0, MONEY), EC_COST)
MONEY -= EC_PAID
EX_FLAG:4444 -= EC_PAID
EC_STATE:EC_DEBT += EC_COST - EC_PAID
EC_REPAID = MIN(MAX(0, MONEY), EC_STATE:EC_DEBT)
MONEY -= EC_REPAID
EX_FLAG:4444 -= EC_REPAID
EC_STATE:EC_DEBT -= EC_REPAID
EC_WORKSHOP = EC_WORK:CL_WORKSHOP * (100 + 25 * EC_TECH:3) / 100 * EC_EFFECT / 100
IF EC_STATE:EC_SHIFT_MODE == 1
	EC_RESEARCH = EC_WORKSHOP
	EC_WORKSHOP = 0
ELSEIF EC_STATE:EC_SHIFT_MODE == 2
	EC_RESEARCH = EC_WORKSHOP / 2
	EC_WORKSHOP -= EC_RESEARCH
ENDIF
IF EC_ACTIVE:CL_WORKSHOP
	CALL EC_PRODUCE(EC_STATE:EC_SHIFT_RECIPE, EC_WORKSHOP)
	EC_BATCHES = RESULT
ENDIF
IF EC_ACTIVE:CL_WORKSHOP && EC_STATE:EC_PROJECT > 0 && EC_STATE:EC_SHIFT_PROJECT == EC_STATE:EC_PROJECT
	CALL EC_RESEARCH_ADVANCE(EC_RESEARCH)
ENDIF
IF EC_STATE:EC_BUILD_ID > 0 && EC_STATE:EC_SHIFT_BUILD == EC_STATE:EC_BUILD_ID
	EC_STATE:EC_BUILD_WORK += 1 + EC_COUNT:CL_WORKSHOP
	IF EC_STATE:EC_BUILD_WORK >= EC_STATE:EC_BUILD_NEED
		EC_I = EC_STATE:EC_BUILD_ID
		IF EC_I <= 7
			CASTLE_LEVEL:EC_I = EC_FACILITY_LEVEL(EC_I) + 1
		ELSE
			EC_LEVEL:EC_I = EC_FACILITY_LEVEL(EC_I) + 1
		ENDIF
		PRINTFORML %EC_FACILITY_NAME(EC_I)%扩建完成，现为{EC_FACILITY_LEVEL(EC_I)}级。
		EC_STATE:EC_BUILD_ID = 0
		EC_STATE:EC_BUILD_WORK = 0
	ENDIF
ENDIF
FOR EC_P, 0, CHARANUM
	SIF CASTLE_WHERE(EC_P) <= 0 || BASE:EC_P:0 <= 0 || CFLAG:EC_P:1 != 0
		CONTINUE
	EC_I = EC_COUNT:CL_QUARTERS * 5
	SIF CASTLE_ROLE(EC_P) == CR_FAMILY
		EC_I += EC_COUNT:CL_FAMILY * 10
	BASE:EC_P:0 = MIN(MAXBASE:EC_P:0, BASE:EC_P:0 + EC_I)
NEXT
EC_BOOK = EC_STATE:EC_BOOK_CURSOR
EC_LEDGER:EC_BOOK:0 = DAY + 1
EC_LEDGER:EC_BOOK:1 = EC_INCOME
EC_LEDGER:EC_BOOK:2 = EC_PAID
EC_LEDGER:EC_BOOK:3 = EC_FLOW:0
EC_LEDGER:EC_BOOK:4 = EC_FLOW:1
EC_LEDGER:EC_BOOK:5 = EC_FLOW:2
EC_LEDGER:EC_BOOK:6 = EC_OTHER
EC_LEDGER:EC_BOOK:7 = MONEY
EC_LEDGER:EC_BOOK:8 = EC_STATE:EC_DEBT
EC_LEDGER:EC_BOOK:9 = EC_MISSING
EC_LEDGER:EC_BOOK:10 = EC_STATE:EC_OPEN_BALANCE
EC_LEDGER:EC_BOOK:11 = EC_REPAID
FOR EC_I, 1, 5
	EC_RESOURCE_BOOK:EC_BOOK:EC_I = EC_STOCK:EC_I - EC_BEFORE:EC_I
NEXT
EC_RESOURCE_BOOK:EC_BOOK:5 = EC_FOOD
EC_RESOURCE_BOOK:EC_BOOK:6 = EC_BATCHES
EC_RESOURCE_BOOK:EC_BOOK:7 = EC_STATE:EC_STAFF
EC_STATE:EC_BOOK_CURSOR = (EC_BOOK + 1) % 28
EC_STATE:EC_BOOK_COUNT = MIN(28, EC_STATE:EC_BOOK_COUNT + 1)
EC_STATE:EC_OPEN_BALANCE = MONEY
FOR EC_I, 0, 3
	EC_FLOW:EC_I = 0
NEXT
PRINTFORML 【城务日结】收入{EC_INCOME}，支付维护与薪资{EC_PAID}，偿还欠款{EC_REPAID}，余额{MONEY}，欠款{EC_STATE:EC_DEBT}。
PRINTFORML 城内生产消耗净变化：粮食{EC_RESOURCE_BOOK:EC_BOOK:1}，建材{EC_RESOURCE_BOOK:EC_BOOK:2}，魔晶{EC_RESOURCE_BOOK:EC_BOOK:3}，制品{EC_RESOURCE_BOOK:EC_BOOK:4}；工艺完成{EC_BATCHES}批。
SIF EC_MISSING > 0
	PRINTFORML 粮食缺口{EC_MISSING}；已记录秩序和次日产出影响，请补给或调整编制。
RETURN 1

@EC_DASHBOARD
#DIM DYNAMIC EC_I
CALL EC_INIT
CALL CASTLE_SCREEN_HEADER("城务与物资", "查阅不消耗行动；上午结束记录出勤，每日夜间结算一次。")
PRINTFORML 秩序{EC_STATE:EC_ORDER}/100　欠款{EC_STATE:EC_DEBT}　每类库存上限{EC_CAPACITY()}　部队整备{EC_STATE:EC_DRILL}/100
PRINTL 在城人物每日各需1粮，军队每100兵需1粮（军粮最多200）；实际出勤每人薪资12。
PRINTL 物流与研究降低粮耗；满仓停止生产，缺粮与欠款降低次日产出。
PRINTL 基础维护为各设施显示基数之和，另加军队维护；整备度最高降低20%军队维护。
SIF DAY <= EC_STATE:EC_GRACE_END
	PRINTFORML 初始维护宽限至第{EC_STATE:EC_GRACE_END+1}日，粮食仍照常消耗。
FOR EC_I, 1, 5
	PRINTFORML %EC_RESOURCE_NAME(EC_I)%：{EC_STOCK:EC_I}/{EC_CAPACITY()}
NEXT
IF EC_STATE:EC_BUILD_ID
	PRINTFORML 建设：%EC_FACILITY_NAME(EC_STATE:EC_BUILD_ID)%　{EC_STATE:EC_BUILD_WORK}/{EC_STATE:EC_BUILD_NEED}
ENDIF
IF EC_STATE:EC_PROJECT
	PRINTFORML 研究：%EC_PROJECT_NAME(EC_STATE:EC_PROJECT)%　{EC_STATE:EC_RESEARCH_WORK}/{EC_PROJECT_VALUE(EC_STATE:EC_PROJECT, 3)}
ENDIF
FOR EC_I, 1, 13
	PRINTFORML %EC_FACILITY_NAME(EC_I)%　等级{EC_FACILITY_LEVEL(EC_I)}　最近出勤{EC_COUNT:EC_I}/{1+EC_FACILITY_LEVEL(EC_I)}　工时{EC_WORK:EC_I}
NEXT
PRINTL 市集可买卖物资，工坊选择生产或研究，王座厅安排建设与税政。
CALL DIALOGUE_OPTION(999, "返回")
INPUT
RETURN

@EC_BOOK_MENU
#DIM DYNAMIC EC_I
#DIM DYNAMIC EC_ROW
CALL CASTLE_SCREEN_HEADER("财务账本", "保留最近28日。其他现金流包含旧商店、战斗及原版事件，不另加第二笔收入。")
FOR EC_I, 0, EC_STATE:EC_BOOK_COUNT
	EC_ROW = (EC_STATE:EC_BOOK_CURSOR + 27 - EC_I) % 28
	PRINTFORML 第{EC_LEDGER:EC_ROW:0}日：期初{EC_LEDGER:EC_ROW:10}＋城务{EC_LEDGER:EC_ROW:1}－维护薪资{EC_LEDGER:EC_ROW:2}＋交易{EC_LEDGER:EC_ROW:3}＋建设{EC_LEDGER:EC_ROW:4}＋研究{EC_LEDGER:EC_ROW:5}＋其他{EC_LEDGER:EC_ROW:6}－还款{EC_LEDGER:EC_ROW:11}＝{EC_LEDGER:EC_ROW:7}
	PRINTFORML 欠款{EC_LEDGER:EC_ROW:8}　缺粮{EC_LEDGER:EC_ROW:9}
	PRINTFORML 城内物资净变化：粮{EC_RESOURCE_BOOK:EC_ROW:1}／材{EC_RESOURCE_BOOK:EC_ROW:2}／晶{EC_RESOURCE_BOOK:EC_ROW:3}／制品{EC_RESOURCE_BOOK:EC_ROW:4}；需粮{EC_RESOURCE_BOOK:EC_ROW:5}，工艺{EC_RESOURCE_BOOK:EC_ROW:6}批，出勤{EC_RESOURCE_BOOK:EC_ROW:7}人。
NEXT
SIF EC_STATE:EC_BOOK_COUNT == 0
	PRINTL 尚未完成首日结算。
CALL DIALOGUE_OPTION(999, "返回")
INPUT
RETURN

@EC_MARKET_MENU
#DIM DYNAMIC EC_R
#DIM DYNAMIC EC_N
CALL EC_INIT
CALL CASTLE_SCREEN_HEADER("市集交易", "每笔交易消耗1行动；正数购买，负数出售，0取消。")
PRINTFORML 今日余量{MAX(0, EC_TRADE_LIMIT()-EC_STATE:EC_TRADE_VOLUME)}单位；报价买高卖低，不靠立即倒卖获利。
FOR EC_R, 1, 5
	CALL DIALOGUE_OPTION(EC_R, @"%EC_RESOURCE_NAME(EC_R)%　库存{EC_STOCK:EC_R}　买入{EC_QUOTE(EC_R,1)}／卖出{EC_QUOTE(EC_R,0)}")
NEXT
CALL DIALOGUE_OPTION(999, "返回")
INPUT
EC_R = RESULT
SIF EC_R < 1 || EC_R > 4
	RETURN
PRINTL 输入数量（买入为正，卖出为负，0取消）：
INPUT
EC_N = RESULT
CALL EC_TRADE(EC_R, EC_N)
RETURN

@EC_BUILD_MENU
#DIM DYNAMIC EC_I
CALL CASTLE_SCREEN_HEADER("设施建设", "一条建设队列；消耗1行动并支付费用，上午开工后夜间累计进度。")
IF EC_STATE:EC_BUILD_ID
	PRINTFORML 当前：%EC_FACILITY_NAME(EC_STATE:EC_BUILD_ID)%　{EC_STATE:EC_BUILD_WORK}/{EC_STATE:EC_BUILD_NEED}；完成前不能重复开工。
	CALL DIALOGUE_OPTION(999, "返回")
	INPUT
	RETURN
ENDIF
FOR EC_I, 1, 13
	SIF EC_FACILITY_LEVEL(EC_I) >= 10
		CONTINUE
	CALL DIALOGUE_OPTION(EC_I, @"%EC_FACILITY_NAME(EC_I)%　{EC_FACILITY_LEVEL(EC_I)}→{EC_FACILITY_LEVEL(EC_I)+1}　资金{400*(EC_FACILITY_LEVEL(EC_I)+1)*(EC_FACILITY_LEVEL(EC_I)+1)}　建材{10*(EC_FACILITY_LEVEL(EC_I)+1)}　工期{EC_FACILITY_LEVEL(EC_I)+3}")
NEXT
CALL DIALOGUE_OPTION(999, "返回")
INPUT
CALL EC_BUILD_START(RESULT)
RETURN

@EC_RESEARCH_MENU
#DIM DYNAMIC EC_I
CALL CASTLE_SCREEN_HEADER("研究项目", "研究成果永久生效；已付款项目保留进度，不因切换模式消失。")
IF EC_STATE:EC_PROJECT
	PRINTFORML %EC_PROJECT_NAME(EC_STATE:EC_PROJECT)%　{EC_STATE:EC_RESEARCH_WORK}/{EC_PROJECT_VALUE(EC_STATE:EC_PROJECT,3)}
	CALL DIALOGUE_OPTION(10, "亲自推进：1行动、2魔晶，增加5工时")
ELSE
	FOR EC_I, 1, 4
		IF EC_TECH:EC_I
			PRINTFORML 已完成：%EC_PROJECT_NAME(EC_I)%——%EC_PROJECT_EFFECT(EC_I)%
		ELSE
			CALL DIALOGUE_OPTION(EC_I, @"%EC_PROJECT_NAME(EC_I)%　资金{EC_PROJECT_VALUE(EC_I,0)}　建材{EC_PROJECT_VALUE(EC_I,1)}　魔晶{EC_PROJECT_VALUE(EC_I,2)}　工时{EC_PROJECT_VALUE(EC_I,3)}")
			PRINTFORML %EC_PROJECT_EFFECT(EC_I)%
		ENDIF
	NEXT
ENDIF
CALL DIALOGUE_OPTION(999, "返回")
INPUT
IF RESULT == 10
	CALL EC_RESEARCH_MANUAL
ELSE
	CALL EC_PROJECT_START(RESULT)
ENDIF
RETURN

@EC_PRODUCTION_MENU
#DIM DYNAMIC EC_I
CALL CASTLE_SCREEN_HEADER("工坊排程", "调整计划免费；上午结束拍下模式和配方，下午调整次日生效。每批8工时。")
PRINTFORML 当前模式{EC_STATE:EC_MODE}（0生产／1研究／2各半）　配方：%EC_RECIPE_NAME(EC_STATE:EC_RECIPE)%　储备工时{EC_STATE:EC_CRAFT_WORK}/80
FOR EC_I, 1, 4
	CALL DIALOGUE_OPTION(EC_I, @"%EC_RECIPE_NAME(EC_I)%：建材{EC_RECIPE_VALUE(EC_I,2,0)}＋魔晶{EC_RECIPE_VALUE(EC_I,3,0)} → 建材{EC_RECIPE_VALUE(EC_I,2,1)}／魔晶{EC_RECIPE_VALUE(EC_I,3,1)}／制品{EC_RECIPE_VALUE(EC_I,4,1)}")
NEXT
CALL DIALOGUE_OPTION(10, "模式：专注生产")
CALL DIALOGUE_OPTION(11, "模式：专注研究")
CALL DIALOGUE_OPTION(12, "模式：工时各半")
CALL DIALOGUE_OPTION(999, "返回")
INPUT
IF RESULT >= 1 && RESULT <= 3
	IF EC_STATE:EC_RECIPE != RESULT
		EC_STATE:EC_RECIPE = RESULT
		EC_STATE:EC_CRAFT_WORK = 0
		PRINTL 已切换配方，旧配方储备工时清零；物资不变。
	ENDIF
ELSEIF RESULT >= 10 && RESULT <= 12
	EC_STATE:EC_MODE = RESULT - 10
ENDIF
RETURN

@EC_POLICY_MENU
CALL CASTLE_SCREEN_HEADER("税政", "低税80%且秩序每日+2；标准100%；高税125%但秩序每日-3。调整消耗1行动。")
PRINTFORML 当前政策{EC_STATE:EC_POLICY}（0低税／1标准／2高税）；秩序和威望影响实际收入。
CALL DIALOGUE_OPTION(0, "低税安抚")
CALL DIALOGUE_OPTION(1, "标准税政")
CALL DIALOGUE_OPTION(2, "高税筹款")
CALL DIALOGUE_OPTION(999, "返回")
INPUT
SIF RESULT < 0 || RESULT > 2 || RESULT == EC_STATE:EC_POLICY
	RETURN
LOCAL = RESULT
CALL CASTLE_SPEND
SIF RESULT == 0
	RETURN
EC_STATE:EC_POLICY = LOCAL
RETURN

@EC_FACILITY_MENU(EC_ID)
#DIM DYNAMIC EC_ID
CALL CASTLE_SCREEN_HEADER(EC_FACILITY_NAME(EC_ID), EC_FACILITY_PURPOSE(EC_ID))
PRINTFORML 等级{EC_FACILITY_LEVEL(EC_ID)}　维护基数{EC_UPKEEP(EC_ID)*EC_FACILITY_LEVEL(EC_ID)}／日　岗位上限{1+EC_FACILITY_LEVEL(EC_ID)}　最近出勤{EC_COUNT:EC_ID}
PRINTL 上午结束记录在场成年部下及成年家属；俘虏、外出者、伤倒者不出勤。
PRINTL 初始生产设施有少量自动产出；人员与研究进一步提高效率。
SIF EC_ID == CL_STORE
	PRINTFORML 每类库存容量{EC_CAPACITY()}；满仓停止新增，不删除旧档超额库存。
IF EC_ID == CL_BARRACKS || (EC_ID >= CL_WORKSHOP && EC_ID <= CL_MARKET)
	PRINTFORML 当前开工状态{EC_ACTIVE:EC_ID}；停工不生产，仍支付一半设施维护。
	CALL DIALOGUE_OPTION(1, "切换开工／停工（1行动）")
	CALL DIALOGUE_OPTION(999, "返回")
	INPUT
	SIF RESULT != 1
		RETURN
	CALL CASTLE_SPEND
	SIF RESULT == 0
		RETURN
	EC_ACTIVE:EC_ID = 1 - EC_ACTIVE:EC_ID
ELSE
	CALL DIALOGUE_OPTION(999, "返回")
	INPUT
ENDIF
RETURN

@EC_SHORT(EC_INPUT, EC_PLACE)
#FUNCTION
#DIM DYNAMIC EC_INPUT
#DIM DYNAMIC EC_PLACE
SIF EC_INPUT == 225
	RETURNF 21165
SIF EC_INPUT == 226
	RETURNF 21167
SIF EC_INPUT == 227
	RETURNF 21160
SIF EC_PLACE == CL_THRONE && EC_INPUT == 224
	RETURNF 21166
SIF EC_PLACE == CL_WORKSHOP && EC_INPUT == 223
	RETURNF 21163
SIF EC_PLACE == CL_WORKSHOP && EC_INPUT == 224
	RETURNF 21162
SIF EC_PLACE == CL_MARKET && EC_INPUT == 221
	RETURNF 21161
SIF EC_PLACE >= CL_FARM && EC_PLACE != CL_MARKET && EC_INPUT == 221
	RETURNF 21165
RETURNF 0

@EC_COMMAND(EC_INPUT)
#DIM DYNAMIC EC_INPUT
SELECTCASE EC_INPUT
CASE 21160
	CALL EC_DASHBOARD
CASE 21161
	SIF CASTLE_STATE:2 != CL_MARKET
		RETURN 0
	CALL EC_MARKET_MENU
CASE 21162
	SIF CASTLE_STATE:2 != CL_WORKSHOP
		RETURN 0
	CALL EC_RESEARCH_MENU
CASE 21163
	SIF CASTLE_STATE:2 != CL_WORKSHOP
		RETURN 0
	CALL EC_PRODUCTION_MENU
CASE 21165
	CALL EC_FACILITY_MENU(CASTLE_STATE:2)
CASE 21166
	SIF CASTLE_STATE:2 != CL_THRONE
		RETURN 0
	CALL EC_POLICY_MENU
CASE 21167
	CALL EC_BOOK_MENU
ENDSELECT
RETURN 0
